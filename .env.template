# carrynerd environment — copy to .env, fill in, keep .env out of git (it is).
#
# Nothing here is read from a file at runtime. Locally, load it into the shell
# before `npm run dev` or any python script:
#
#     set -a; source .env; set +a
#
# In production every var is set in Vercel (the project is linked, so
# `vercel env add NAME production` works), and DATABASE_URL additionally goes
# into the data repo's Actions secrets for the nightly alerts matcher.

# ── Runtime database — Supabase ──────────────────────────────────────────────
# The *transaction pooler* string: host ends in .pooler.supabase.com, port
# 6543 — not the direct 5432 connection. src/lib/db.ts sets `prepare: false`
# for exactly this. Needed by /api/click, /api/watch, /api/confirm,
# /api/unsubscribe and the /internal/ dashboard; the catalog endpoints
# (/api/browse, /api/catalog) deliberately have no database.
# After creating the project, apply the schema once (use the direct 5432
# string for psql, session features are fine there):
#     psql "$DATABASE_URL" -f alerts/schema.sql
DATABASE_URL=

# ── /internal/ dashboard ─────────────────────────────────────────────────────
# Fails closed when unset — nobody can log in, including you. There is no rate
# limiting on the login (serverless makes in-memory throttling useless), so it
# must be long and random:  openssl rand -base64 24
DASHBOARD_PASSWORD=

# ── Alert email — Resend ─────────────────────────────────────────────────────
# The sending domain must be verified in Resend (SPF + DKIM records) or every
# confirmation email dies at the API. ALERT_FROM is optional — code defaults
# to `carrynerd <alerts@carrynerd.com>` — but the default only sends once
# carrynerd.com is the verified domain.
RESEND_API_KEY=
ALERT_FROM=

# Signing secret for the delivery webhook, from Resend → Webhooks after adding
# an endpoint at https://<site>/api/webhooks/resend. Starts `whsec_`.
#
# Subscribe the endpoint to at least email.delivered, email.bounced and
# email.complained — the last two are what write the suppression list, and
# without them the nightly will go on mailing dead addresses forever. Add
# email.opened and email.clicked only if open/click tracking is switched on in
# Resend as well; the dashboard reports them and does not need them.
#
# /api/webhooks/resend rejects every request when this is unset rather than
# accepting unsigned ones, so a forgotten value fails loudly at Resend's end.
RESEND_WEBHOOK_SECRET=

# ── Canonical origin ─────────────────────────────────────────────────────────
# Optional: astro.config.mjs already defaults to https://carrynerd.com. Set it
# only to override — e.g. to keep links on gearherd.com until the new domain
# is bought, attached to Vercel, and out of DNS quarantine.
SITE_URL=

# ── /internal/ funnel + traffic panels — optional ────────────────────────────
# Only the Vercel-pageview panels need these; everything else on the dashboard
# degrades independently without them. Token: Vercel dashboard → Settings →
# Tokens (needs Web Analytics read). IDs below are this project's, from
# .vercel / the CLI link.
VERCEL_ANALYTICS_TOKEN=
VERCEL_PROJECT_ID=prj_neKnHJx1TwourPojBm5WrxG4Ra3o
VERCEL_TEAM_ID=team_6ZkTPosOj9kYDtnAHmpmhHDQ

# ── Local pipeline runs — optional ───────────────────────────────────────────
# The nightly workflow hardcodes this in its own env; set it locally so a
# hand-run crawl identifies itself the same way.
CARRYNERD_CONTACT=https://carrynerd.com/bot
