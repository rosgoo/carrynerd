---
/* The browse header: navigation, and only navigation.
 *
 * Shared by every page that mounts the island — the front page and each brand
 * page. What is left in it is navigation and nothing else: the wordmark, the
 * catalogue's numbers, the categories, Sale, Brands and the theme.
 *
 * Everything that acts on the grid has moved out, in order: the view and unit
 * toggles, then Filters, and now the search field. They live in the toolbar
 * directly above the results — see components/BrowseShell.astro — because that
 * is what they change. A header is where you go somewhere else from.
 */
import Logo from './Logo.astro';
import { SITE_NAME_DISPLAY } from '../lib/brand.js';
import { hubs } from '../lib/hubs.js';
import ThemeToggle from './ThemeToggle.astro';
---
<header class="browsehead">
  <a class="brand" href="/"><Logo size={17} />{SITE_NAME_DISPLAY}</a>
  <div class="stats" id="stats"></div>
  {/* Stays in the header at every width now. It used to be moved into the
      filter panel on a phone, which put the site's navigation inside a drawer
      labelled Filters and left the header itself holding nothing but a way to
      open that drawer — the one control on it that was not navigation. The
      trade is the categories menu, which is hidden here below the breakpoint:
      Sale, Brands and the theme fit beside the wordmark on one row and the
      menu does not, and every category is in the footer of every page. */}
  <div class="hbtns" id="hbtns">
    {/* The same menu the other header carries, in the same place, because the
        two headers are the same site. Without it the front page — the one page
        every reader starts on — was the only page in the catalogue with no way
        up to a category except the sitemap row in the footer, which is why the
        hubs looked like they only existed once you were already standing on
        one. Identical markup to Base.astro on purpose: it is a <details>, so it
        needs no script, and the dismissal handler in the layout finds it here
        exactly as it finds it there. */}
    <details class="hmenu">
      <summary class="hbtn">Categories</summary>
      <div class="hmenupanel">
        {hubs.map((hub) => <a href={hub.href}>{hub.title}</a>)}
      </div>
    </details>
    {/* Same reason as the swap in Base.astro: the footer is not a place you
        can reach on a page that keeps loading. This header has no Browse to
        trade for it — you are already browsing — so it is an addition. */}
    <a class="hbtn" href="/carry-on/">Carry-on</a>
    <a class="hbtn" href="/sale/">Sale</a>
    <a class="hbtn" href="/brands/">Brands</a>
    <ThemeToggle />
  </div>
</header>
