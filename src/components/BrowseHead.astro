---
/* The browse header: the one that carries the search field.
 *
 * Shared by every page that mounts the island — the front page and each brand
 * page — because the island reaches into it by id. #q and the hamburger are not
 * decoration the pages happen to agree on; they are controls browse.js wires,
 * and a page that mounted the island without them would fail on the first line
 * of loadURL(). One component is what stops that being a thing anyone has to
 * remember.
 *
 * What is deliberately *not* here: the view toggle and the unit toggle. Both
 * change how the results are drawn, so both now sit in the toolbar directly
 * above them, beside the sort — see components/BrowseShell.astro. In the nav
 * they read as navigation, which is the one thing they are not.
 */
import Logo from './Logo.astro';
import { SITE_NAME_DISPLAY } from '../lib/brand.js';
import { hubs } from '../lib/hubs.js';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  /** What to say in the search field. A scoped page searches inside its own
   *  shelf, so it says so rather than offering the catalogue. */
  placeholder?: string;
}

const {
  placeholder = 'search brand, model, material, feature…',
} = Astro.props;
---
<header class="browsehead">
  <a class="brand" href="/"><Logo size={17} />{SITE_NAME_DISPLAY}</a>
  <div class="stats" id="stats"></div>
  <div class="searchwrap">
    <input id="q" type="search" placeholder={placeholder} autocomplete="off" spellcheck="false" />
  </div>
  {/* Moves into the filter panel below the mobile breakpoint — a phone has
      room for the wordmark and one control beside it, and the panel is the
      only full-width surface on the page. See mountChrome() in browse.js. */}
  <div class="hbtns" id="hbtns">
    {/* The same menu the other header carries, in the same place, because the
        two headers are the same site. Without it the front page — the one page
        every reader starts on — was the only page in the catalogue with no way
        up to a category except the sitemap row in the footer, which is why the
        hubs looked like they only existed once you were already standing on
        one. Identical markup to Base.astro on purpose: it is a <details>, so it
        needs no script, and the dismissal handler in the layout finds it here
        exactly as it finds it there. */}
    <details class="hmenu">
      <summary class="hbtn">Categories</summary>
      <div class="hmenupanel">
        {hubs.map((hub) => <a href={hub.href}>{hub.title}</a>)}
      </div>
    </details>
    <a class="hbtn" href="/sale/">Sale</a>
    <a class="hbtn" href="/brands/">Brands</a>
    <ThemeToggle />
  </div>
  {/* Stays in the header at every width: it is the way back to the controls
      that left it. */}
  <button class="hbtn burger" id="railtoggle" aria-controls="rail" aria-expanded="false">
    <span class="bars" aria-hidden="true"></span>Filters
  </button>
</header>
