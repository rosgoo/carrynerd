---
/* Everything measurement, in one place the layout mounts once.
 *
 * Pageviews only. Vercel's are free within the Hobby allowance and take no
 * configuration, and the route they are filed under comes from Astro.params,
 * which means the model pages aggregate under /bags/[brand]/[model] rather
 * than arriving as several hundred separate one-view rows. It is a no-op
 * locally — it detects development mode and logs instead of sending — so
 * `astro dev` stays quiet.
 *
 * Speed Insights is deliberately not here. It measures web vitals, which is a
 * different question from anything this site is trying to answer, and it bills
 * separately at $10 per project per month on Pro. Cloudflare Web Analytics
 * reports Core Web Vitals for nothing if that question ever gets asked.
 *
 * The two events that actually matter — product_view and buy_click — do not
 * come through here at all. They go to our own /api/click; see
 * scripts/analytics.js for why.
 */
import Analytics from '@vercel/analytics/astro';
---
<Analytics />
<script>
  import { initAnalytics } from '../scripts/analytics.js';
  initAnalytics();
</script>
