---
/* The comparison table the hub, facet and airline pages are all built around.
 *
 * One component because these pages exist to be compared with each other: a
 * reader who learns the column order on /daypacks/ should not have to learn it
 * again on /carry-on/united-airlines/. The last column is the one thing that
 * changes — a size page is arguing about weight per litre, an airline page
 * about whether the thing fits a gauge — so it swaps and nothing else does.
 */
import Measure from './Measure.astro';
import { bagHref } from '../lib/catalog.js';
import {
  fmtPrice, fmtVolume, fmtWeightBoth, fmtDims, fmtLinear, gramsPerLitre,
} from '../lib/format.js';
import type { Bag } from '../lib/types.d.ts';

interface Props {
  bags: Bag[];
  /** 'gpl' — grams per litre; 'linear' — the h+w+d total airlines measure. */
  metric?: 'gpl' | 'linear';
}

const { bags, metric = 'gpl' } = Astro.props;
---
{/* Six columns, one of them a dimension triple: this does not fold onto a
    phone at any padding worth having, so it scrolls inside its own box rather
    than taking the page sideways with it. */}
<div class="xscroll">
<table class="spectable brandtable">
  <thead>
    <tr>
      <th>Model</th><th>Volume</th><th>Weight</th><th>H×W×D</th>
      <th>{metric === 'linear' ? 'Linear' : 'g/L'}</th>
      <th>Price</th>
    </tr>
  </thead>
  <tbody>
    {bags.map((bag) => {
      const density = gramsPerLitre(bag);
      return (
        <tr>
          <td>
            <a href={bagHref(bag)}><b class="bmaker">{bag.brand}</b> {bag.name}</a>
          </td>
          <td class={bag.volume_l == null ? 'nil' : ''}>{fmtVolume(bag.volume_l) ?? '—'}</td>
          <td class={bag.weight_g == null ? 'nil' : ''}><Measure value={fmtWeightBoth(bag.weight_g)} /></td>
          <td class={bag.dims_cm == null ? 'nil' : ''}><Measure value={fmtDims(bag.dims_cm)} /></td>
          {metric === 'linear' ? (
            <td class={bag.linear_cm == null ? 'nil' : ''}><Measure value={fmtLinear(bag.linear_cm)} /></td>
          ) : (
            <td class={density == null ? 'nil' : ''}>{density == null ? '—' : density.toFixed(0)}</td>
          )}
          <td>{fmtPrice(bag.price_min, bag.currency)}</td>
        </tr>
      );
    })}
  </tbody>
</table>
</div>
