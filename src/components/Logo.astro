---
/* Vernier caliper, built from four straight-edged shapes so it holds together
   at 14px in the header and as a favicon. No graduation ticks on the beam —
   they are the first thing you notice on the real tool and the first thing that
   turns to grey mush at this size.

   What identifies it instead is the asymmetry: a small fixed nub on the left, a
   tall sliding head on the right, and the beam running on past it. Symmetry was
   tried first and read as a letter H. The two outside jaws taper slightly, but
   only slightly — enough to point, not enough to leave a sub-pixel tip. The gap
   between them is the subject of the mark, so nothing is drawn in it. */
const { size = 16, class: className = '' } = Astro.props;
---
<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <!-- beam: the rule, and the only stroke crossing the full width -->
  <rect x="2" y="11.5" width="28" height="4" fill="currentColor" />
  <!-- fixed jaw: inside nub above, outside jaw below. Its right face stays
       plumb through both, because that is the measuring surface. -->
  <rect x="2" y="8" width="3.5" height="3.5" fill="currentColor" />
  <path d="M2 15.5h3.5V25H2.8z" fill="currentColor" />
  <!-- slider: head and jaw are one rigid piece, so one path. Its left face is
       the opposing measuring surface — one unbroken edge, top to tip. -->
  <path d="M14 8h9.5v7.5h-6L16.8 25H14z" fill="currentColor" />
</svg>
