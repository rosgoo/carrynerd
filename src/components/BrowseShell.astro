---
/* The browse instrument panel: filter rail, results, comparison tray, drawer.
 *
 * Everything below the header that browse.js draws into or reads out of. It was
 * the front page's markup and it is now shared, because a brand page is the
 * same instrument pointed at one shelf and /sale/ is the same instrument
 * pointed at everything discounted — see the `brand` and `sale` props. Keeping
 * one copy is what stops them drifting into a rail that has a control on one
 * page and not the others, which the island would find out about at runtime.
 *
 * The default slot goes inside #results and is the answer for a reader with no
 * JavaScript: the island replaces it on load. It is not a placeholder — it is
 * the page's only working fallback, and render() hands it back if the first
 * request fails.
 */
import { airlines, carryOnAirlines } from '../lib/carryon.js';

interface Props {
  /** The brand this page is about, if it is about one. Present, the rail loses
   *  its Brand group — the path already answered that question — and the island
   *  scopes every request and every count to the brand. */
  brand?: { slug: string; name: string } | null;
  /** True on /sale/, which is the same instrument with `on_sale` settled by the
   *  path. The rail loses its On sale check for the same reason a brand page
   *  loses its Brand group: it is the page, not a filter on it. */
  sale?: boolean;
  /** Currencies other than USD in whatever the page is showing. The price
   *  slider compares figures across them without converting, which is worth
   *  saying under the slider rather than leaving a reader to spot a £. */
  otherCurrencies?: string[];
  /** The order the page opens on, when brand A–Z is the wrong answer for it.
   *  A default and not a lock — see DEFAULT_SORT in scripts/browse.js. */
  sort?: string;
  /** What to say in the search field. A scoped page searches inside its own
   *  shelf, so it says so rather than offering the catalogue. Was a prop of
   *  BrowseHead until the field moved down here with the other controls. */
  placeholder?: string;
}

const {
  brand = null, sale = false, otherCurrencies = [], sort = 'brand',
  placeholder = 'search brand, model, material, feature…',
} = Astro.props;

/* Two spellings of the same fact, both read by browse.js. `lock` is what rides
 * on the request — and what tells the server to count the rail against this
 * page's shelf rather than the catalogue. `unlock` is the same thing as an
 * ordinary filter, for the link out.
 *
 * One page is at most one of these: a scope is what the path already settled,
 * and no route settles two. */
const scope = brand
  ? {
      lock: `scope=brand:${brand.slug}`,
      unlock: new URLSearchParams({ brand: brand.slug }).toString(),
      label: 'Brand',
      value: brand.name,
      out: 'Compare against other brands →',
    }
  : sale
    ? {
        lock: 'scope=sale',
        unlock: 'sale=1',
        label: 'Availability',
        value: 'On sale',
        out: 'Compare against everything →',
      }
    : null;

const lock = scope?.lock ?? null;
const unlock = scope?.unlock ?? null;
---
<div class="shell" id="shell" data-lock={lock} data-unlock={unlock} data-sort={sort}>
  {/* Alphabetical by heading. The old order was the order the facets were
      built in, which meant the one people reach for first — Brand — sat
      ninth, below three collapsed groups. Nothing here ranks above anything
      else, so the only ordering that a stranger can predict is the alphabet.
      Data coverage is the exception and stays pinned last: it filters
      nothing, it is a footnote about the catalog. */}
  <aside class="rail" id="rail">
    {/* Shown only while the rail is a drawer. */}
    <div class="railhead">
      <b>Filters</b>
      <button class="railclose" id="railclose" aria-label="Close filters">✕</button>
    </div>

    {/* The one part of the rail that is about you rather than about the
        catalog, so it sits above every filter group rather than in the
        alphabet with them: a saved filter is how you arrive at the filters,
        not one of them.

        Ships hidden and is revealed by the island. There are no accounts
        here — all of this lives in this browser's localStorage, see
        lib/store.js — so with no JavaScript there is nothing to reveal, and
        a panel offering to remember things that cannot be remembered is
        worse than no panel. */}
    <section class="saved" id="saved" hidden>
      <div class="savedhead">
        <b>Saved</b>
        <button class="savedbtn" id="savefilter">+ Save filter</button>
      </div>
      <form class="savedform" id="savedform" hidden>
        <input id="savedname" type="text" maxlength="48" autocomplete="off"
               spellcheck="false" placeholder="name this filter"
               aria-label="Name for this filter" />
        <button class="savedok" type="submit">Save</button>
        <button class="savedcancel" type="button" id="savedcancel"
                aria-label="Cancel">✕</button>
      </form>
      <div class="savedlist" id="savedlist"></div>
      <p class="savedmsg" id="savedmsg" role="status" aria-live="polite" hidden></p>
      <button class="check favonly" id="f-fav" aria-pressed="false">
        <i></i>★ Favourites only<b id="favcount">0</b>
      </button>
    </section>

    {/* Where the group the path settled would be, saying what is standing in
        for it. A locked filter that says nothing is a filter a reader spends a
        while looking for, and the link is the honest answer to why they were
        looking: the same filters, on the whole catalogue, with this one merely
        ticked. browse.js keeps its href in step with the rail — see syncURL(). */}
    {scope && (
      <section class="flock">
        <em class="lbl">{scope.label}</em>
        <b>{scope.value}</b>
        <a id="unscope" href={`/?${unlock}`}>{scope.out}</a>
      </section>
    )}

    {/* First in the alphabet, and the only group in the rail that is a
        measurement rather than a field: every carrier's published limit,
        checked against the bag's stated dimensions. Closed by default — 34
        rows open would push every other control below the fold — and it grows
        its own search box at that length, the same way Brand does. */}
    <details class="fgroup">
      <summary>Airline — carry-on fit</summary>
      <div class="fbody">
        <div class="checks" id="f-airline"></div>
        {/* One sentence, and the same sentence everywhere fit is computed —
            here, /carry-on/, an airline page and CarryOn.astro. It used to be
            four notes of eighty-odd words each, no two worded alike, all
            saying largest-axis-first and soft-bags-compress and check-before-
            you-fly. A caveat restated on every surface is not more honest than
            one stated once; it is a site that does not trust the reader to
            have read it, and /about is where the long version belongs. */}
        <p class="note" style="padding:10px 0 0;border:none">
          Fit is computed from stated dimensions, largest axis first. Ticking
          more than one carrier requires a bag to clear them all.
          {' '}<a href="/carry-on/">All {airlines.length} carriers</a>.
        </p>
      </div>
    </details>

    <details class="fgroup" open>
      <summary>Availability</summary>
      <div class="fbody">
        <div class="checks">
          <button class="check" id="f-stock" aria-pressed="false"><i></i>In stock only</button>
          {/* Absent on /sale/, where it is the page rather than a filter on it. */}
          {!sale && <button class="check" id="f-sale" aria-pressed="false"><i></i>On sale</button>}
        </div>
      </div>
    </details>

    {!brand && (
      <details class="fgroup" open>
        <summary>Brand</summary>
        <div class="fbody"><div class="checks" id="f-brand"></div></div>
      </details>
    )}

    <details class="fgroup" open>
      <summary>Category</summary>
      <div class="fbody"><div class="chips" id="f-cat"></div></div>
    </details>

    <details class="fgroup" open>
      <summary>Colour</summary>
      <div class="fbody"><div class="checks" id="f-color"></div></div>
    </details>

    <details class="fgroup">
      <summary>Features</summary>
      <div class="fbody">
        <div class="checks" id="f-feat"></div>
        {/* The one genuinely non-obvious thing in the rail, kept, and the
            scaffolding around it dropped. Two flags sit next to each other
            reading almost the same and meaning different things; that is worth
            a sentence. "Read off product pages" and "often a different set of
            bags" were the reader working it out again after being told. */}
        <p class="note" style="padding:10px 0 0;border:none">
          <b>Carry-on compliant</b> is measured — the stated dimensions clear
          all {carryOnAirlines.length} carriers above. <b>Carry-on claimed</b>
          {' '}is the brand's own word for it.
        </p>
      </div>
    </details>

    <details class="fgroup">
      <summary>Laptop</summary>
      <div class="fbody">
        {/* Fixed options rather than the catalog's 29 distinct values. Brands
            state 15.6 and 16.2 and 16.9, and a list that long is a list nobody
            reads — but the sizes people own cluster on the whole inches, and
            "at least 16" already collects the 16.2. A minimum, because
            laptop_in is the largest machine a bag takes: see the note on
            laptopMin in api/browse.ts, and the laptop hub pages, which read it
            the same way. */}
        <select id="laptop-min" aria-label="Minimum laptop size">
          <option value="">Any laptop size</option>
          <option value="13">Fits 13″ and up</option>
          <option value="14">Fits 14″ and up</option>
          <option value="15">Fits 15″ and up</option>
          <option value="16">Fits 16″ and up</option>
          <option value="17">Fits 17″ and up</option>
        </select>
        <p class="note" style="padding:10px 0 0;border:none">
          Only bags whose maker states a size. A bag we have no figure for is
          not shown here rather than guessed at.
        </p>
      </div>
    </details>

    <details class="fgroup">
      <summary>Material</summary>
      <div class="fbody"><div class="checks" id="f-mat"></div></div>
    </details>

    <details class="fgroup">
      <summary>Max linear dimension</summary>
      <div class="fbody">
        <div class="rangerow">
          <input id="linear-max" type="number" min="0" step="5"
                 placeholder="max total h+w+d (cm)"
                 data-ph-cm="max total h+w+d (cm)"
                 data-ph-in="max total h+w+d (in)" />
        </div>
        <div class="checks" style="margin-top:8px">
          <button class="check" data-preset="carryon" aria-pressed="false"><i></i>Fits common carry-on (<span class="u-cm">≤115cm</span><span class="u-in">≤45in</span> linear)</button>
          <button class="check" data-preset="underseat" aria-pressed="false"><i></i>Fits under seat (<span class="u-cm">≤40×30×20</span><span class="u-in">≤16×12×8</span>)</button>
        </div>
      </div>
    </details>

    <details class="fgroup" open>
      <summary>Price</summary>
      <div class="fbody">
        <div class="dual" data-dual="price">
          <div class="track"><div class="fill"></div></div>
          <input class="lo" type="range" aria-label="Minimum price" />
          <input class="hi" type="range" aria-label="Maximum price" />
        </div>
        <div class="rangerow">
          <input id="price-min" type="number" placeholder="min" min="0" step="10" />
          <em>—</em>
          <input id="price-max" type="number" placeholder="max" min="0" step="10" />
        </div>
        {otherCurrencies.length > 0 && (
          <p class="note" style="padding:10px 0 0;border:none">
            Mostly USD. {otherCurrencies.join(' and ')} where the brand sells
            in it — shown as charged, never converted, so this range compares
            the figures rather than their worth.
          </p>
        )}
      </div>
    </details>

    <details class="fgroup" open>
      <summary>Volume — litres</summary>
      <div class="fbody">
        {/* The slider's bounds come from the catalog at runtime, so the
            track always spans what actually exists rather than a guess
            baked in here — and on a brand page, what exists is that
            brand's. See initSliders() in browse.js. */}
        <div class="dual" data-dual="vol">
          <div class="track"><div class="fill"></div></div>
          <input class="lo" type="range" aria-label="Minimum volume" />
          <input class="hi" type="range" aria-label="Maximum volume" />
        </div>
        <div class="rangerow">
          <input id="vol-min" type="number" placeholder="min" min="0" step="1" />
          <em>—</em>
          <input id="vol-max" type="number" placeholder="max" min="0" step="1" />
        </div>
      </div>
    </details>

    {/* Grams, in both units, and deliberately so. Every weight the reader is
        shown now follows the unit toggle — a card, a table cell, the comparison
        sheet — but these two numbers are not shown, they are typed, and what is
        typed here is spelled straight into the query string and into whatever
        saved filters this browser is keeping. Converting them would silently
        re-point every link anyone has already shared and every filter they have
        already saved at a different set of bags. That is a migration, not a
        formatting change, and it is not this one. The heading says grams so
        that the one control still in metric says which metric it means. */}
    <details class="fgroup">
      <summary>Weight — grams</summary>
      <div class="fbody">
        <div class="dual" data-dual="weight">
          <div class="track"><div class="fill"></div></div>
          <input class="lo" type="range" aria-label="Minimum weight" />
          <input class="hi" type="range" aria-label="Maximum weight" />
        </div>
        <div class="rangerow">
          <input id="weight-min" type="number" placeholder="min" min="0" step="50" />
          <em>—</em>
          <input id="weight-max" type="number" placeholder="max" min="0" step="50" />
        </div>
      </div>
    </details>

    <details class="fgroup">
      <summary>Data coverage</summary>
      <div class="fbody">
        <div class="cov" id="coverage"></div>
        {/* The one surviving copy of this, and it lives here because this is
            the panel about coverage — the only place a reader has asked. It
            was on four pages, explaining a dash to people who had not asked
            about the dash. Elsewhere the dash carries a title attribute, which
            is what a reader who does wonder will reach for. */}
        <p class="note" style="padding:10px 0 0;border:none">
          Shown as “—” when not established, never estimated.
        </p>
      </div>
    </details>

  </aside>

  <main>
    <div class="toolbar">
      {/* First, and the only accent-filled control on the bar. Below the
          breakpoint the rail is a drawer, and this is the entire way back to
          it — every filter on the page is behind this one button, so it is the
          one thing here that cannot read as another of the small outlined
          toggles beside it. It used to sit up in the header, which is the one
          place on the page that is not about the results; it belongs on the
          bar that carries the sort and the units, because like them it acts on
          the grid below. Hidden at desk widths, where the rail is simply
          there. */}
      <button class="tbtn filters" id="railtoggle" aria-controls="rail"
              aria-expanded="false">
        <span class="bars" aria-hidden="true"></span>Filters
      </button>
      {/* Sort, out here on the toolbar, in the slot Grid/Table used to hold.
        It was in the rail, at the top of the filter groups, and the argument
        for that was width: on a phone it was the widest control on a bar
        that had no room for it, taking a full row of sticky chrome to say
        "Brand A–Z". True at the time and no longer — the site is grid-only
        now, the view pair is gone, and this fits in what it left behind.

        What the rail argument never answered is that below 900px the rail is
        a drawer labelled Filters, so ordering a list meant opening a panel
        that says it is for narrowing one. Sort does not narrow anything; it
        is how you read the answer you already have, which is the same job as
        the unit toggle beside it, and it belongs on the bar with the things
        that act on the grid rather than behind a door that names something
        else.

        `selected` rather than a value set from script: the page can open on
        an order of its own — /sale/ does — and the select has to say so
        before the island's first answer lands. The id is unchanged, because
        browse.js finds this by id and does not care where it sits. */}
      <select class="tbsort" id="sort" aria-label="Sort the results">
        {/* Same value either way — the server sorts by brand then model, and
          within one brand that is the model. Only the label changes,
          because "Brand A–Z" on a page with one brand on it reads as a
          control that does nothing. */}
        <option value="brand" selected={sort === 'brand'}>{brand ? 'Model A–Z' : 'Brand A–Z'}</option>
        <option value="price-asc" selected={sort === 'price-asc'}>Price ↑</option>
        <option value="price-desc" selected={sort === 'price-desc'}>Price ↓</option>
        {/* Anything not on sale has no discount to rank and sorts last, so
          this is a real control on every page rather than only on /sale/. */}
        <option value="discount" selected={sort === 'discount'}>Discount ↓</option>
        <option value="vol-asc" selected={sort === 'vol-asc'}>Volume ↑</option>
        <option value="vol-desc" selected={sort === 'vol-desc'}>Volume ↓</option>
        <option value="weight-asc" selected={sort === 'weight-asc'}>Weight ↑</option>
        {/* Abbreviated, and not for the sake of it: a select is as wide as its
          widest option, so these two were setting the width of the whole
          control and pushing Clear onto a second row of buttons at 390. "G/L"
          is what the spec cell on every card calls this and what the old table
          column called it, so the short form is the one a reader has already
          met. */}
        <option value="gpl" selected={sort === 'gpl'}>G / L ↑</option>
        <option value="ppl" selected={sort === 'ppl'}>Price / L ↑</option>
      </select>
      {/* The search field, down from the header. It is the widest thing here
          and the only one that wants every pixel it can get, so it takes what
          the two controls before it leave and, below the breakpoint, the whole
          of its own row. */}
      <div class="searchwrap">
        <input id="q" type="search" placeholder={placeholder} autocomplete="off"
               spellcheck="false" />
      </div>
      <div class="count" id="count">loading…</div>
      <button class="tbtn" id="clear">Clear</button>
      <div class="spacer"></div>
      {/* Units used to live in the header nav, beside Brands and the category
          menu, where they read as a place to go rather than as a knob on what
          is already on screen. It belongs here, next to the sort, for the
          reason the sort does: both change how the grid below reads without
          changing which bags are in it.

          Both units on screen, the live one lit, pressing the other selects
          it. It used to be one button printing the unit you were already in,
          which read as the opposite of the theme toggle beside it — that one
          shows where you are going. Two small buttons an inch apart
          disagreeing about their own grammar is a thing a reader can only
          settle by pressing one, and this removes the question rather than
          answering it. The layout's markup carries the long version of this
          note. */}
      <div class="units" id="units" role="group" aria-label="Measurement units">
        <button class="tbtn" type="button" data-unit="cm" aria-pressed="true"
                title="Show measurements in centimetres and grams"
                aria-label="Show measurements in centimetres and grams">cm</button>
        <button class="tbtn" type="button" data-unit="in" aria-pressed="false"
                title="Show measurements in inches and pounds"
                aria-label="Show measurements in inches and pounds">in</button>
      </div>
    </div>
    <div id="results">
      <slot />
    </div>
  </main>
</div>

<div class="tray" id="tray">
  <div class="picked" id="picked"></div>
  <button class="btn ghost" id="cmpclear">Clear</button>
  <button class="btn" id="cmpopen">Compare</button>
</div>

<div class="overlay" id="cmpoverlay">
  <div class="sheet">
    <header>
      <h2>Comparison</h2>
      <button class="btn ghost" data-close>Close ✕</button>
    </header>
    <div class="inner" id="cmpbody"></div>
  </div>
</div>

<div class="overlay" id="detoverlay">
  <div class="drawer">
    <header>
      {/* openDetail() fills this with a link to the seller when the bag has
          one, and with plain text when it does not. */}
      <h2 id="dettitle">Detail</h2>
      {/* Carries its own data-id, set per bag by openDetail() — the cards
          take theirs from the article around them, and this has no article
          around it. */}
      <button class="fav" id="detfav" data-fav aria-pressed="false"
              title="Save to favourites" aria-label="Save to favourites">☆</button>
      <button class="btn ghost" data-close>Close ✕</button>
    </header>
    <div class="inner" id="detbody"></div>
    {/* Outside .inner on purpose: the way out to the seller is the drawer's
        main exit and it used to sit last in the scroll, below the colourway
        table and the signup, where nobody scrolled to find it. openDetail()
        sets the href, the label and the tracking attributes — the bar is the
        seller's store for any bag we hold a URL for, and only falls back to
        the model page when we do not. */}
    <a class="btn detbuy" id="detbuy" href="/">Open ↗</a>
  </div>
</div>
