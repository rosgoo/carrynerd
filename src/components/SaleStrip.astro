---
/* Newly on sale — the drops still standing from the last few days.
 *
 * Reads bags.json, not the ledger. track_prices.py has already worked out
 * which models moved and annotated each one with `price_direction`,
 * `previous_price` and `at_lowest`; re-deriving that here would mean parsing
 * 30k history rows at build time to reach the same 50 answers.
 *
 * "Newly" is load-bearing and is why this filters on `price_direction` rather
 * than on `on_sale`. `on_sale` is a standing state — 1,168 models carry a
 * compare-at price, most of them permanently, and a strip of those is a
 * clearance aisle nobody returns to. A recent drop is news, and it is the thing
 * the price ledger exists to know that a storefront's own badge cannot tell you.
 *
 * "Recent" is a window and not the last run, which is a correction rather than
 * a preference. The ledger is a change log: a sale that runs all week writes a
 * row on the night it starts and is silent afterwards, so keyed to one run this
 * strip showed a sale on day one and hid it on days two through five while it
 * was still on. It rendered nothing at all on 4 of the first 7 nights of
 * August. The window lives in track_prices.py — the annotation is already the
 * answer by the time it reaches here, and a bag whose price has since rebounded
 * never carries `down`, so nothing below has to check whether the sale is over.
 */
import { fmtPrice } from '../lib/format.js';
import { bagHref } from '../lib/catalog.js';
import type { Bag } from '../lib/types.d.ts';

interface Props {
  bags?: Bag[];
  limit?: number;
}

const { bags = [], limit = 12 } = Astro.props;

// A 1% move is a rounding artefact or a currency wobble, not a sale worth
// putting at the top of the page. 5% is the floor for calling it news.
const MIN_OFF = 0.05;

/* A drop we can actually quote: both ends of the move are known numbers, so
   the percentage below is arithmetic on real prices rather than on a missing
   field read as zero. Stated as a type predicate because that is also what
   lets the map divide them without re-checking. */
type Drop = Bag & { price_min: number; previous_price: number };

const fell = (bag: Bag): bag is Drop =>
  bag.price_direction === 'down' &&
  typeof bag.previous_price === 'number' &&
  typeof bag.price_min === 'number' &&
  bag.price_min > 0 &&
  bag.previous_price > bag.price_min;

const drops = bags
  .filter(fell)
  .map((bag) => ({ bag, off: 1 - bag.price_min / bag.previous_price }))
  .filter((row) => row.off >= MIN_OFF)
  .sort((a, b) => b.off - a.off || a.bag.price_min - b.bag.price_min)
  .slice(0, limit);
---
{drops.length > 0 && (
  <section class="salestrip" aria-labelledby="salestrip-h">
    <div class="salehead">
      <h2 id="salestrip-h">Newly on sale</h2>
    </div>

    <ul class="salerow">
      {drops.map(({ bag, off }) => (
        <li class="salecard">
          <a href={bagHref(bag)}>
            <span class="saleshot" style={bag.image_bg && `--shot-bg:${bag.image_bg}`}>
              {bag.image
                ? <img src={bag.image} alt="" loading="lazy" width="120" height="120" />
                : <span class="none">NO IMAGE</span>}
              <b class="saleoff">−{Math.round(off * 100)}%</b>
            </span>
            <span class="salebrand">{bag.brand}</span>
            <span class="salename">{bag.name}</span>
            <span class="saleprice">
              <strong>{fmtPrice(bag.price_min, bag.currency)}</strong>
              <s>{fmtPrice(bag.previous_price, bag.currency)}</s>
            </span>
            {bag.at_lowest && <span class="tag lowest">Lowest recorded</span>}
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
