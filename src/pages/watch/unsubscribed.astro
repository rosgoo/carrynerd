---
import Base from '../../layouts/Base.astro';
import { SITE_NAME_DISPLAY } from '../../lib/brand.js';
---
<Base title={`Unsubscribed — ${SITE_NAME_DISPLAY}`} noindex={true}>
  <div class="midpage">
    <h1>Unsubscribed</h1>
    <p>
      Done, and done properly — the watch and your address are deleted from the
      database, not flagged. Nothing of yours is left behind.
    </p>
    <p>
      Our email provider keeps its own delivery log, as every provider does, so
      records of past sends live there for a while. That is outside what we can
      erase for you.
    </p>
    <p><a class="btn" href="/">Back to the index</a></p>
  </div>
</Base>
