---
import Base from '../../layouts/Base.astro';
import { SITE_NAME } from '../../lib/brand.js';
---
<Base title={`Link didn't work — ${SITE_NAME}`} noindex={true}>
  <div class="midpage">
    <h1>That link didn't work</h1>
    <p>
      Either it has already been used, or it was cut in half somewhere between
      your mail client and here — long links are the usual culprit.
    </p>
    <p>
      Setting the watch up again from the bag's page takes a moment and issues
      a fresh link.
    </p>
    <p><a class="btn" href="/">Back to the index</a></p>
  </div>
</Base>
