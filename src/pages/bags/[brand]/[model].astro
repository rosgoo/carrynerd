---
import Base from '../../../layouts/Base.astro';
import PriceHistory from '../../../components/PriceHistory.astro';
import WatchForm from '../../../components/WatchForm.astro';
import Offers from '../../../components/Offers.astro';
import Measure from '../../../components/Measure.astro';
import CarryOn from '../../../components/CarryOn.astro';
import { bags, bagSlug, bagHref, isIndexable, priceSeries, priceChanges, trackingSince, variantUrls } from '../../../lib/catalog.js';
import { hubByCategory } from '../../../lib/hubs.js';
import { catLabel, featureLabel, sourceLabel } from '../../../lib/labels.js';
import { SITE_NAME_DISPLAY } from '../../../lib/brand.js';
import {
  fmtPrice, fmtPriceRange, fmtWeight, fmtWeightBoth, fmtDims, fmtVolume, fmtLaptop,
  fmtLinear, gramsPerLitre, pricePerLitre, currencySymbol,
} from '../../../lib/format.js';
import type { Bag } from '../../../lib/types.d.ts';

export function getStaticPaths() {
  return bags.map((bag) => ({
    params: { brand: bag.brand_slug, model: bagSlug(bag) },
    props: { bag },
  }));
}

interface Props {
  bag: Bag;
}

const { bag } = Astro.props;

const series = priceSeries(bag);
const changes = priceChanges(bag);

// Positional: wayUrls[i] belongs to bag.variants[i], and is null where the
// colourway cannot be placed on a page — see variantUrls in lib/catalog.js.
const wayUrls = variantUrls(bag);

// Related: same brand first, then same category elsewhere. Cheap internal
// linking, and it is what a reader comparing two packs actually wants.
const related = [
  ...bags.filter((b) => b.id !== bag.id && b.brand_slug === bag.brand_slug && b.category === bag.category),
  ...bags.filter((b) => b.id !== bag.id && b.brand_slug !== bag.brand_slug && b.category === bag.category),
].slice(0, 8);

/* The other capacities this model is sold in.
 *
 * A brand selling one bag in 20L, 26L and 35L publishes it as one product with
 * a size axis, and the index used to publish it the same way — one row, one
 * volume, the other two sizes nowhere. They are separate entries now, which is
 * how a buyer thinks of them and how they are reviewed, but it leaves a reader
 * who typed the model name on whichever size they happened to land on with no
 * way back to the line.
 *
 * So: the siblings, by volume, in the one place on the page a size question
 * gets asked — beside the volume itself, above the buy button, rather than
 * eight items down in "Similar" among other people's bags.
 */
const siblings = bag.split_from
  ? bags
      .filter((b) => b.split_from === bag.split_from && b.id !== bag.id)
      .sort((a, b) => (a.volume_l ?? 0) - (b.volume_l ?? 0))
  : [];

const density = gramsPerLitre(bag);
const perLitre = pricePerLitre(bag);

/* The category hub, if the category has one — the way from this bag to the
 * comparable ones at other brands, which "Similar" below only reaches eight
 * of. Rendered as its own row rather than inside `specs` because it is the
 * one value on the table that is a link. */
const hub = hubByCategory.get(bag.category) ?? null;

const specs = [
  ['Price', fmtPriceRange(bag.price_min, bag.price_max, bag.currency), null],
  ['Volume', fmtVolume(bag.volume_l), bag.volume_source],
  ['Dimensions', fmtDims(bag.dims_cm), bag.dims_source],
  ['Linear (h+w+d)', fmtLinear(bag.linear_cm), bag.dims_source],
  ['Weight', fmtWeightBoth(bag.weight_g), bag.weight_source],
  ['Grams per litre', density ? density.toFixed(0) : null, null],
  ['Price per litre', perLitre ? `${currencySymbol(bag.currency)}${perLitre.toFixed(2)}` : null, null],
  ['Laptop', fmtLaptop(bag.laptop_in), null],
  ['Colourways', bag.colors?.length || null, null],
  ['SKUs', bag.variant_count || null, null],
  ['In stock', bag.in_stock ? 'Yes' : 'No', null],
];

const dims = bag.dims_cm ?? [];
const quantity = (value: number | null | undefined, unitCode: string) =>
  value == null ? undefined : { '@type': 'QuantitativeValue', value, unitCode };

// dims_cm is sorted largest-axis-first because brands disagree about ordering,
// so height/width/depth here is the sorted triple, not a claim about which way
// up the bag was measured. For carry it is right nearly every time — bags are
// taller than they are wide — and it is still strictly more than the zero
// dimensions most storefronts publish.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${bag.brand} ${bag.name}`,
  brand: { '@type': 'Brand', name: bag.brand },
  category: catLabel(bag.category),
  url: new URL(bagHref(bag), Astro.site).href,
  ...(bag.image ? { image: [bag.image] } : {}),
  ...(bag.gtin ? { gtin: bag.gtin } : {}),
  height: quantity(dims[0], 'CMT'),
  width: quantity(dims[1], 'CMT'),
  depth: quantity(dims[2], 'CMT'),
  weight: quantity(bag.weight_g, 'GRM'),
  additionalProperty: [
    bag.volume_l != null && { '@type': 'PropertyValue', name: 'Volume', value: bag.volume_l, unitCode: 'LTR' },
    bag.laptop_in != null && { '@type': 'PropertyValue', name: 'Maximum laptop size', value: bag.laptop_in, unitCode: 'INH' },
    bag.linear_cm != null && { '@type': 'PropertyValue', name: 'Linear dimension', value: Math.round(bag.linear_cm), unitCode: 'CMT' },
  ].filter(Boolean),
  ...(bag.price_min != null
    ? {
        offers: {
          '@type': 'AggregateOffer',
          priceCurrency: bag.currency ?? 'USD',
          lowPrice: bag.price_min,
          highPrice: bag.price_max ?? bag.price_min,
          offerCount: bag.variant_count ?? 1,
          availability: bag.in_stock
            ? 'https://schema.org/InStock'
            : 'https://schema.org/OutOfStock',
          url: bag.url,
        },
      }
    : {}),
};

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Bags', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: bag.brand, item: new URL(`/brands/${bag.brand_slug}/`, Astro.site).href },
    { '@type': 'ListItem', position: 3, name: bag.name },
  ],
};

const title = `${bag.brand} ${bag.name} — specs, dimensions & price | ${SITE_NAME_DISPLAY}`;
// Metric in the meta description regardless of the reader's toggle: this is
// the crawler-facing copy, it is baked at build time, and the structured data
// below states CMT too.
const facts = [
  fmtVolume(bag.volume_l),
  fmtDims(bag.dims_cm)?.cm,
  fmtWeight(bag.weight_g),
].filter(Boolean).join(', ');
const description =
  `${bag.brand} ${bag.name}${facts ? `: ${facts}` : ''}. ` +
  `${fmtPriceRange(bag.price_min, bag.price_max, bag.currency)} across ${bag.variant_count ?? 0} SKUs. ` +
  'Specs normalised from the brand’s own product feed, with sources shown.';
---
{/* Held out of search results until the model has specs worth arriving for —
    see isIndexable in lib/catalog.js. noindex,follow, not nofollow: the page
    is ordinary, linked and crawlable, it simply is not a landing page yet. */}
<Base title={title} description={description} image={bag.image}
      ogType="product" noindex={!isIndexable(bag)} nofollow={false}>
  <Fragment slot="head">
    {/* is:inline because this is data for a crawler, not code: it must ship in
        the document as written rather than be bundled and fetched. */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbs)} />
  </Fragment>

  {/* The bag this page is about, in the one form a static page can hand to a
      client script: attributes baked in at build time. scripts/analytics.js
      reads these to fire product_view, the denominator of the referral rate. */}
  <div class="page"
       data-product-view
       data-bag-id={bag.id}
       data-brand={bag.brand}
       data-model={bag.name}
       data-category={bag.category}
       data-price={bag.price_min}>
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Bags</a> <span>/</span>
      <a href={`/brands/${bag.brand_slug}/`}>{bag.brand}</a> <span>/</span>
      <b>{bag.name}</b>
    </nav>

    <div class="modelhead">
      <div class="modelshot" style={bag.image_bg && `--shot-bg:${bag.image_bg}`}>
        {bag.image
          ? <img src={bag.image} alt={`${bag.brand} ${bag.name}`} width="640" height="640" loading="eager" />
          : <span class="none">NO IMAGE</span>}
      </div>

      <div class="modelmeta">
        {/* Internal, not the brand's own site. The reader is deciding on this
            bag and the buy button is inches away; an outbound homepage link
            here would compete with it and convert worse. The brand's site is
            one click on, from /brands/, where browsing is the point. */}
        <a class="cbrand" href={`/brands/${bag.brand_slug}/`}>{bag.brand}</a>
        <h1>{bag.name}</h1>

        <div class="pricebox">
          <strong>{fmtPriceRange(bag.price_min, bag.price_max, bag.currency)}</strong>
          {bag.previous_price && bag.price_direction === 'down' && (
            <span class="was">was {fmtPrice(bag.previous_price, bag.currency)}</span>
          )}
          {bag.at_lowest && <span class="tag lowest">Lowest recorded</span>}
          {!bag.in_stock && <span class="tag oos">Out of stock</span>}
          {bag.on_sale && <span class="tag sale">On sale</span>}
        </div>
        {bag.lowest_ever != null && bag.lowest_ever !== bag.price_min && (
          <p class="note">Lowest we have recorded: {fmtPrice(bag.lowest_ever, bag.currency)}</p>
        )}

        <dl class="keyspecs">
          {[
            ['Volume', fmtVolume(bag.volume_l)],
            ['Weight', fmtWeightBoth(bag.weight_g)],
            ['H×W×D', fmtDims(bag.dims_cm)],
            ['Laptop', fmtLaptop(bag.laptop_in)],
          ].map(([label, value]) => (
            <div>
              <dt>{label}</dt>
              <dd class={value ? '' : 'nil'}>
                {typeof value === 'object' && value !== null
                  ? <Measure value={value} />
                  : value ?? '—'}
              </dd>
            </div>
          ))}
        </dl>

        {siblings.length > 0 && (
          <p class="sizes">
            Also in{' '}
            {siblings.map((b, i) => (
              <Fragment>
                {i > 0 && (i === siblings.length - 1 ? ' and ' : ', ')}
                <a href={bagHref(b)}>{fmtVolume(b.volume_l)}</a>
              </Fragment>
            ))}
          </p>
        )}

        {/* Above the buy button and deliberately quieter than it: saving is
            for the reader who is still deciding, and the storefront link is
            what this page is for. Hidden until scripts/favbutton.js says
            otherwise — there is no account to save it to, only this browser.
            The link goes to the browse page filtered to the saved list. */}
        <div class="savebar" data-favbar hidden>
          <button type="button" data-fav-toggle={bag.id} aria-pressed="false">
            ☆ Save to favourites
          </button>
          <a href="/?favonly=1">Saved bags →</a>
          <p class="savedmsg" data-favmsg role="status" aria-live="polite" hidden></p>
        </div>

        <a class="btn buy" href={bag.url} target="_blank" rel="noopener nofollow"
           data-buy="product_page"
           data-buy-id={bag.id}
           data-buy-brand={bag.brand}
           data-buy-model={bag.name}
           data-buy-price={bag.price_min}>
          View on {bag.brand} ↗
        </a>
      </div>
    </div>

    {/* Directly under the hero, ahead of the specs. A reader who has just seen
        the photo and the price is at the moment of deciding, and "not at that
        price" is the commonest answer — catching that address here, rather
        than at the foot of a long page they will not scroll to, is the whole
        point of the form. */}
    <WatchForm bagId={bag.id} name={`the ${bag.name}`} currency={bag.currency} />

    <section>
      <h2>Specifications</h2>
      <table class="spectable">
        <tbody>
          <tr>
            <th scope="row">Category</th>
            <td>
              {hub
                ? <a href={hub.href}>{catLabel(bag.category)}</a>
                : catLabel(bag.category)}
              {sourceLabel(bag.category_source) && (
                <i class="prov">{sourceLabel(bag.category_source)}</i>
              )}
            </td>
          </tr>
          {specs.map(([label, value, source]) => (
            <tr>
              <th scope="row">{label}</th>
              <td class={value == null ? 'nil' : ''}>
                {typeof value === 'object' && value !== null
                  ? <Measure value={value} />
                  : value ?? '—'}
                {sourceLabel(source) && <i class="prov">{sourceLabel(source)}</i>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="note">
        A “—” means we could not establish the value, not that it is zero.
        Nothing here is estimated.
      </p>
    </section>

    <PriceHistory series={series} changes={changes} since={trackingSince} currency={bag.currency} />

    {bag.variants?.length > 0 && (
      <section>
        <h2>Colourways &amp; SKUs</h2>
        {/* A colourway name, a SKU, a price and a stock word will not fold
            onto a 320px phone, and unwrapped this table was taking the whole
            page sideways with it — which put every other block on the page,
            the watch form included, out of line with the screen. It scrolls
            inside its own box instead, as the brand and airline tables
            already do. */}
        <div class="xscroll">
        <table class="vartable">
          <thead>
            <tr><th>Colourway</th><th>SKU</th><th>Price</th><th>Stock</th></tr>
          </thead>
          <tbody>
            {bag.variants.map((v, i) => (
              <tr>
                {/* The link is on the colourway, the row's identity, and not
                    also on the SKU beside it: both would point at the same
                    page, and a screen reader would read the destination out
                    twice. Outbound like every other buy path here, and
                    attributed the same way — the tracker reads the seller off
                    the href, and the price it reports is this SKU's, which is
                    the one on the row. */}
                {wayUrls[i] ? (
                  <td class="waycell">
                    <a href={wayUrls[i]} target="_blank" rel="noopener nofollow"
                       data-buy="variant_row"
                       data-buy-id={bag.id}
                       data-buy-brand={bag.brand}
                       data-buy-model={bag.name}
                       data-buy-price={v.price}>
                      {v.image && <img class="waythumb" src={v.image} alt="" loading="lazy" width="26" height="26" style={v.image_bg && `--shot-bg:${v.image_bg}`} />}
                      <span>{v.color || v.title || '—'}</span>
                    </a>
                  </td>
                ) : (
                  <td class="waycell">
                    {v.image && <img class="waythumb" src={v.image} alt="" loading="lazy" width="26" height="26" style={v.image_bg && `--shot-bg:${v.image_bg}`} />}
                    {v.color || v.title || '—'}
                  </td>
                )}
                <td class="mono">{v.sku || '—'}</td>
                <td>
                  {fmtPrice(v.price, bag.currency)}
                  {v.compare_at && v.price && v.compare_at > v.price && (
                    <s> {fmtPrice(v.compare_at, bag.currency)}</s>
                  )}
                </td>
                <td class={v.available ? 'instock' : 'nil'}>
                  {v.available ? 'in stock' : 'out'}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        </div>
      </section>
    )}

    <CarryOn bag={bag} />

    {(bag.materials?.length || bag.features?.length) && (
      <section>
        <h2>Materials &amp; features</h2>
        <div class="tagrow">
          {(bag.materials ?? []).map((m) => <span class="tag">{m}</span>)}
          {(bag.features ?? []).map((f) => <span class="tag">{featureLabel(f)}</span>)}
        </div>
        {!bag.features?.length && (
          <p class="note">
            {bag.features_source === 'product-page'
              ? 'No features detected on the product page. This one we did look at properly.'
              : 'No features detected — read that as unknown rather than absent. ' +
                'We have only seen this brand’s short description text, which for ' +
                'some brands is three sentences of marketing copy with no feature ' +
                'vocabulary in it at all.'}
          </p>
        )}
      </section>
    )}

    <Offers bag={bag} />

    {related.length > 0 && (
      <section>
        <h2>Similar</h2>
        <ul class="related">
          {related.map((b) => (
            <li>
              <a href={bagHref(b)}>
                <b>{b.brand}</b> {b.name}
                <em>{[fmtVolume(b.volume_l), fmtPrice(b.price_min, b.currency)].filter(Boolean).join(' · ')}</em>
              </a>
            </li>
          ))}
        </ul>
        {hub && (
          <p class="note">
            {related.length} of {hub.bags.length} comparable {hub.plural} in the index.
            {' '}<a href={hub.href}>All {hub.plural}</a>, ranked and split by
            size, or <a href="/carry-on/">by the airline you are flying</a>.
          </p>
        )}
      </section>
    )}

  </div>

  <script>
    import '../../../scripts/favbutton.js';
  </script>
</Base>
