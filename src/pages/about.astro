---
import Base from '../layouts/Base.astro';
import { meta, brands, bags, indexablePaths, trackingSince } from '../lib/catalog.js';
import { hubs } from '../lib/hubs.js';
import { SITE_NAME, SITE_NAME_DISPLAY, CONTACT } from '../lib/brand.js';
import { organization } from '../lib/schema.js';

/* The page that says what this is.
 *
 * Two jobs, and they turn out to be the same job. A search for the name has
 * nothing to land on: every other page here answers "what is this bag", which
 * is a question about a product, and none of them answer "what is carrynerd",
 * which is a question about the site. And the thing that makes an aggregator
 * worth trusting is its method — how it decides what a bag is, what it does
 * when a brand publishes nothing, what it refuses to guess. That method is
 * real, it is enforced in code, and until now it was written down only in
 * source comments where no reader would ever find it.
 *
 * So: one page, the entity and the method together, rather than an "about"
 * that says nothing and a "methodology" nobody clicks. Every number on it is
 * read from the manifest the pipeline writes, so it cannot drift from the
 * catalogue it describes — the failure mode of a hand-written methodology page
 * is that it slowly stops being true, and nothing here can.
 */

const title = `About ${SITE_NAME_DISPLAY} — how the index is built`;
const description =
  `${SITE_NAME} is a spec index for bags: volume, weight, dimensions and price, `
  + 'normalised across brands from their own published product data. How it is '
  + 'built, what it covers, and what it refuses to guess.';

const fmt = (n: number) => n.toLocaleString('en-US');

/* Rejections are published per reason, and the reasons are prefixed by family.
   Totalling by prefix rather than listing thirteen leaf codes keeps the number
   honest while staying readable — and the two families mean genuinely
   different things, which is the distinction worth drawing. */
const rejected = meta.rejected ?? {};
const totalFor = (prefix: string) =>
  Object.entries(rejected)
    .filter(([reason]) => reason.startsWith(prefix))
    .reduce((n, [, count]) => n + count, 0);

const notBags = totalFor('not-a-bag');
const unclassified = totalFor('unclassified');

const coverage = meta.coverage ?? {};
const COVERAGE_ROWS = [
  ['Price', 'price_min', 'Every storefront publishes one.'],
  ['Weight', 'weight_g', 'Usually in the feed, and the field brands are best at.'],
  ['Volume', 'volume_l', 'Often in the title or a spec block rather than a field of its own.'],
  ['Dimensions', 'dims_cm', 'The hardest to get, and the one the carry-on tables need. Read off product pages one at a time.'],
  ['Laptop size', 'laptop_in', 'Only where a brand states it. Never inferred from the bag'
    + "’s own dimensions — a 40 cm-tall pack does not necessarily take a 16″ laptop."],
] as const;

const indexable = indexablePaths.size;
const withDims = coverage.dims_cm?.have ?? 0;

/* Where each spec value actually came from.
 *
 * Every extracted field carries a `*_source` sibling naming the rule that
 * produced it, so a wrong number is auditable rather than mysterious. Grouped
 * here into the three kinds of work behind a figure, because that split is the
 * whole reason this is not a five-line script: a number the brand published as
 * a field, a number sitting in the brand's own prose that had to be parsed out
 * of it, and a number that appeared on no feed anywhere and had to be read off
 * a product page one request at a time.
 *
 * Keyed on the family prefix rather than the full rule name — there are ~38 of
 * those and they are an implementation detail, where the three families are
 * the thing worth showing. `other` catches any family added later so a new
 * rule shows up as uncounted rather than silently vanishing from the total.
 */
const PROVENANCE = [
  {
    label: 'Published as a field',
    families: ['shopify', 'magento', 'bellroy-api'],
    why: "Returned as structured data by the brand's own storefront API. Nothing to interpret.",
  },
  {
    label: "Parsed from the brand's own text",
    families: ['title', 'description', 'variant-option', 'campsaver'],
    why: 'Stated, but in prose — a title reading “Travel Pack 45L”, a spec line in a description, a variant option called “21L”.',
  },
  {
    label: 'Read off the product page',
    families: ['product-page', 'pages'],
    why: 'On no feed at all. Fetched a page at a time and read out of the rendered spec block or the schema.org data behind it.',
  },
] as const;

const provenance = (() => {
  const counted = new Map(PROVENANCE.map((row) => [row.label, 0]));
  let other = 0;
  for (const bag of bags) {
    for (const field of ['dims_source', 'volume_source', 'weight_source'] as const) {
      const source = bag[field];
      if (!source) continue;
      const family = String(source).split(':')[0];
      const row = PROVENANCE.find((r) => (r.families as readonly string[]).includes(family));
      if (row) counted.set(row.label, (counted.get(row.label) ?? 0) + 1);
      else other += 1;
    }
  }
  const rows = PROVENANCE.map((row) => ({ ...row, count: counted.get(row.label) ?? 0 }));
  const total = rows.reduce((n, row) => n + row.count, 0) + other;
  return { rows, other, total };
})();

/* How the category was decided, which is a precedence question and therefore
   one where the honest thing to publish is how often each level actually
   fires rather than only the order they are tried in. */
const catSources = (() => {
  const by = new Map<string, number>();
  for (const bag of bags) {
    const source = bag.category_source;
    if (source) by.set(source, (by.get(source) ?? 0) + 1);
  }
  const of = (...keys: string[]) =>
    keys.reduce((n, key) => n + (by.get(key) ?? 0), 0);
  return {
    title: of('title'),
    shelf: of('collection', 'shelf', 'magento-shelf', 'bellroy-shelf'),
    tag: of('tag'),
  };
})();

/* Currency is the one field with a bucket meaning "nothing said otherwise",
   and it is large enough that leaving it out of a page about provenance would
   be the omission the rest of the page argues against.
   Counted twice on purpose, because the two numbers answer different
   questions and the smaller one alone would undersell it: currency is resolved
   once per *store*, so meta counts brands, and the number of models carrying
   the result is an order of magnitude larger. */
const assumedBrands = meta.currency_sources?.assumed ?? 0;
const assumedModels = bags.filter((bag) => bag.currency_source === 'assumed').length;

/* The ledger's first observation, to the day.
   Month and year alone would read as "since August 2026" — which, written in
   August 2026, claims a history of days in the grammar of one measured in
   years. The exact date claims nothing: a reader can see how long it is and
   decide for themselves what that is worth, and the sentence stays true as
   the answer grows. */
const since = trackingSince
  ? new Date(trackingSince).toLocaleDateString('en-US', {
      day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
    })
  : null;

const built = meta.generated_at
  ? new Date(meta.generated_at).toLocaleDateString('en-US', {
      day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
    })
  : null;

const canonical = new URL(Astro.url.pathname, Astro.site).href;

/* The Organization again, identically, because this is the page that describes
 * it — the home page carries it for the site-name feature, and the recommended
 * home for the entity itself is the page a reader would go to for the same
 * answer. Same `@id`, so this is one declaration in two places rather than two
 * organisations that look alike.
 *
 * No `dateModified` on the page node, deliberately. This page rebuilds nightly
 * and its figures move only when the catalogue moves, so stamping every build
 * with a fresh date would be the same false-freshness claim lib/lastmod.js
 * exists to avoid. The visible line at the foot says which build the numbers
 * came from, which is a statement about the data and true.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    organization(Astro.site),
    {
      '@type': 'AboutPage',
      '@id': `${canonical}#page`,
      url: canonical,
      name: title,
      description,
      inLanguage: 'en',
      isPartOf: { '@id': new URL('/#website', Astro.site).href },
      about: { '@id': new URL('/#organization', Astro.site).href },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Bags', item: new URL('/', Astro.site).href },
        { '@type': 'ListItem', position: 2, name: 'About', item: canonical },
      ],
    },
  ],
};
---
<Base title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="page">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Bags</a> <span>/</span> <b>About</b>
    </nav>
    <h1>About {SITE_NAME_DISPLAY}</h1>
    <p class="note">
      {SITE_NAME} is a spec index for bags. It reads what brands publish about
      their own products and normalises it, so that a volume, a weight and a
      set of dimensions can be compared across makers who all describe them
      differently. It currently holds {fmt(meta.bag_count ?? bags.length)}
      {' '}models from {brands.length} brands, covering
      {' '}{fmt(meta.sku_count ?? 0)} individual SKUs.
    </p>
    <p class="note">
      It exists because the specification you need in order to choose a bag is
      almost never in one place. One brand gives litres and no dimensions,
      the next gives dimensions in inches and no weight, a third puts the
      laptop size in a paragraph of marketing copy. Comparing three bags means
      opening nine tabs and doing arithmetic. This does that once, nightly, for
      every bag it can reach.
    </p>

    <section>
      <h2>The name</h2>
      <p class="note">
        A carry nerd is what this audience already calls itself — someone who
        knows the difference between 500D and X-Pac, and who has opinions about
        where a water bottle pocket belongs. The name is that phrase, not a
        coinage. The bison is older than the name and stayed.
      </p>
    </section>

    <section>
      <h2>Where the data comes from</h2>
      <p class="note">
        Brands' own published product data: {meta.generated_from}. Nothing is
        bought, licensed or scraped from another comparison site, and no figure
        anywhere on this site is estimated, interpolated or converted from a
        different unit than the one the brand stated.
      </p>
      <p class="note">
        The crawler reads public endpoints only, checks
        {' '}<code>robots.txt</code> first and records why when it is told no,
        paces its requests and identifies itself with a URL pointing at
        {' '}<a href="/bot/">a page explaining what it is</a>. Product images
        are referenced at the brand's own URLs rather than copied, so they
        serve from the brand's CDN and stop working the moment the brand
        removes them. Every model page links back to the product it describes.
      </p>
    </section>

    <section>
      <h2>How it is built</h2>
      <p class="note">
        Five stages, run in order, every night. Each one is idempotent and
        resumable: a stage that dies half way through costs the time it had
        spent and nothing else, because the next run picks up from what is
        already on disk rather than starting again.
      </p>
      <table class="spectable">
        <tbody>
          <tr>
            <th scope="row">1. Fetch</th>
            <td>
              Reads each brand's public catalogue endpoint — one to three
              requests for a whole storefront, whether it sells forty products
              or fourteen hundred. <code>robots.txt</code> is read first and a
              refusal is recorded rather than worked around. The work is split
              across parallel workers by dividing the <em>brand list</em>;
              splitting one brand's requests across workers to get around a
              rate limit would be evasion, and is deliberately not done.
            </td>
          </tr>
          <tr>
            <th scope="row">2. Normalise</th>
            <td>
              The hard stage, and the one the index exists for. Turns
              {' '}{fmt(meta.sku_count ?? 0)} SKUs described
              {brands.length} different ways into one schema.
            </td>
          </tr>
          <tr>
            <th scope="row">3. Enrich</th>
            <td>
              One request per product page, for the fields no feed exposes —
              dimensions above all. Reads the rendered spec block and the
              schema.org data most stores emit for Google Shopping. This is the
              expensive stage: it is capped per night, interleaved across every
              brand with work outstanding so no single store sees a burst, and
              it works through a backlog rather than trying to finish.
            </td>
          </tr>
          <tr>
            <th scope="row">4. Track prices</th>
            <td>
              Diffs every SKU against the last known state and appends only
              what moved. The one output here that cannot be rebuilt: a spec
              can be re-read at any time, a price you failed to record on the
              day it changed is gone.
            </td>
          </tr>
          <tr>
            <th scope="row">5. Validate</th>
            <td>
              The gate. Runs before anything publishes, and refuses the night
              if the catalogue moved further than a night's crawl plausibly
              could.
            </td>
          </tr>
        </tbody>
      </table>
      <p class="note">
        Every page fetched in stage 3 is kept. That sounds like a storage
        decision and is really a correctness one: a parser fix has to be able
        to reach the products it already got wrong, and an incremental crawl by
        definition skips those — the records that most need re-reading are
        exactly the ones "only fetch what is missing" excludes. Because the
        pages are on disk, a corrected rule is re-applied to the whole
        catalogue at a cost of zero requests, and it runs nightly rather than
        when someone remembers.
      </p>
      <p class="note">
        A worked example, because it is the kind of error that survives every
        obvious check: weights arriving as 133&nbsp;g for a serious hiking
        pack, and 109&nbsp;g for another. Both were real numbers on the page —
        one was the detachable hip belt, the other the fabric's weight per
        square metre. Neither is the bag. Guards for that now run over every
        cached page, which is only possible because the pages were kept.
      </p>
    </section>

    <section>
      <h2>What counts as a bag</h2>
      <p class="note">
        A bag brand's catalogue is mostly not bags. Hats, patches, water
        bottles, gift cards, spare buckles and — genuinely — a knife filed
        under Camping&nbsp;&amp;&nbsp;Hiking all arrive through the same feed as
        the backpacks. On the last build, {fmt(notBags)} products were
        classified as not a bag and left out, and a further
        {' '}{fmt(unclassified)} could not be classified confidently either way
        and were held back rather than guessed at.
      </p>
      <p class="note">
        What survives is sorted into {hubs.length} categories by three signals
        in a fixed order of precedence: the product's own <b>title</b> first,
        then the <b>shelf</b> the store files it on, then its <b>tags</b>. A
        title is specific and deliberate — "Travel Pack 45L" says exactly what
        it is. A shelf is deliberate but broad. A tag is neither, and letting
        tags outrank titles filed one maker's entire camera line as hiking
        packs, because it tags them for backpacking.
      </p>
      <table class="spectable">
        <tbody>
          <tr><th scope="row">Decided by title</th><td>{fmt(catSources.title)} models</td></tr>
          <tr><th scope="row">By the store's shelf</th><td>{fmt(catSources.shelf)} models</td></tr>
          <tr><th scope="row">By tags</th><td>{fmt(catSources.tag)} models</td></tr>
        </tbody>
      </table>
      <p class="note">
        Where that order still produces a wrong answer often enough to matter,
        the ruling is written down in a file and applied every night, so a
        correction stays corrected instead of being re-litigated by the next
        run. Exclusion runs before classification and is asked in the other
        direction: a product filed under a shelf the store itself marks as not
        a bag is dropped without its title getting a vote.
      </p>
      <p class="note">
        One bag is often several products. The same pack in four colourways is
        four listings on a storefront and one thing a reader is choosing;
        the last build merged {fmt(meta.products_merged ?? 0)} products into
        the models they are colourways of, and collapsed
        {' '}{fmt(meta.models_collapsed ?? 0)} further duplicate models. The
        colourway table on a model page is where those separate listings still
        exist.
      </p>
    </section>

    <section>
      <h2>What is actually known</h2>
      <p class="note">
        This is the number most comparison sites do not publish. Coverage is
        not uniform, it is not close to complete, and pretending otherwise
        would make every other claim here worth less.
      </p>
      <table class="spectable">
        <thead>
          <tr><th scope="col">Field</th><th scope="col">Have</th><th scope="col">Why</th></tr>
        </thead>
        <tbody>
          {COVERAGE_ROWS.map(([label, field, why]) => (
            <tr>
              <th scope="row">{label}</th>
              <td>{coverage[field] ? `${coverage[field].pct}%` : '—'}</td>
              <td>{why}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="note">
        A missing value is shown as a dash, and a dash never means zero. It
        means the brand did not publish it and we would not invent it. This is
        the single rule the whole index is built on: a filter for bags under
        1&nbsp;kg returns bags known to be under 1&nbsp;kg, not bags whose
        weight is unknown.
      </p>
    </section>

    <section>
      <h2>Every number knows where it came from</h2>
      <p class="note">
        Each extracted value carries a sibling field naming the rule that
        produced it — there are about forty of them — so a figure that looks
        wrong can be traced to the thing that decided it instead of being
        mysterious. That is what makes a correction possible at all: without
        provenance, fixing one bad weight means re-reading every weight.
      </p>
      <p class="note">
        Grouped by the kind of work behind them, the
        {' '}{fmt(provenance.total)} volume, weight and dimension figures in
        the index break down like this. The third row is the one that takes the
        time.
      </p>
      <table class="spectable">
        <thead>
          <tr><th scope="col">Came from</th><th scope="col">Values</th><th scope="col">What that means</th></tr>
        </thead>
        <tbody>
          {provenance.rows.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              <td>{fmt(row.count)}</td>
              <td>{row.why}</td>
            </tr>
          ))}
          {provenance.other > 0 && (
            <tr>
              <th scope="row">Other</th>
              <td>{fmt(provenance.other)}</td>
              <td>A rule added since this table was last grouped.</td>
            </tr>
          )}
        </tbody>
      </table>
    </section>

    <section>
      <h2>What the numbers mean</h2>
      <table class="spectable">
        <tbody>
          <tr>
            <th scope="row">Dimensions</th>
            <td>
              As published, converted to centimetres and inches and shown in
              both. Sorted largest axis first, because brands disagree about
              which of the three they list first — so the triple is height,
              width and depth in the usual case and is not a claim about which
              way up the bag was measured.
            </td>
          </tr>
          <tr>
            <th scope="row">Volume</th>
            <td>The brand's stated capacity. Never computed from dimensions, which would describe a box rather than a bag.</td>
          </tr>
          <tr>
            <th scope="row">Weight</th>
            <td>The empty bag. Where a brand states a weight for a component or a load rating, that is not this field.</td>
          </tr>
          <tr>
            <th scope="row">Carry-on fit</th>
            <td>
              Computed against {' '}<a href="/carry-on/">each airline's published limits</a>,
              and only for bags with all three dimensions — {fmt(withDims)} of
              them. A bag with no dimensions abstains rather than being assumed
              to fit.
            </td>
          </tr>
          <tr>
            <th scope="row">Price</th>
            <td>
              As listed by the brand. Nothing is converted: an exchange rate
              would be a number we invented that moves independently of any
              price, so a range spanning currencies would compare figures
              rather than worth. The currency itself is evidence like anything
              else — read from the feed where it states one, from the store's
              configured market, or from the product page's structured offer.
              Where none of those said anything — {assumedBrands} of the
              {' '}{brands.length} storefronts, carrying
              {' '}{fmt(assumedModels)} models — the price falls back to US
              dollars, and that is an assumption rather than a reading. It is
              the only field on the site with nothing under it, which is why
              the nightly gate checks it specifically.
            </td>
          </tr>
        </tbody>
      </table>
    </section>

    <section>
      <h2>How often it updates</h2>
      <p class="note">
        Nightly. Every price is re-read and every change is written to a
        ledger{since && <> that has recorded every move since {since}</>} — one
        row per actual move, not a daily snapshot — which is what the price
        history on a model page is drawn from. Dimensions are filled in
        continuously, a
        few hundred product pages a night, because they are the field that has
        to be read off a page rather than taken from a feed.
      </p>
    </section>

    <section>
      <h2>What stops a bad night from publishing</h2>
      <p class="note">
        The pipeline runs unattended and deploys what it produces. That is fine
        right up until a change to one parsing rule halves the index — at which
        point every step succeeds, the site rebuilds, and search engines
        recrawl a catalogue missing half its bags. Nothing in a green run would
        say so. So the last stage before publishing is a gate that refuses.
      </p>
      <table class="spectable">
        <tbody>
          <tr>
            <th scope="row">Structural</th>
            <td>
              Absolute truths about a well-formed catalogue: required fields
              present, permalinks unique, every value inside physically
              sane bounds. A bag cannot weigh two grams or be four metres tall.
            </td>
          </tr>
          <tr>
            <th scope="row">Regression</th>
            <td>
              Tonight compared against the copy currently live. The bag count,
              each brand's count and the fill rate of every field each have a
              limit on how far they may fall in one night. A legitimate large
              change is allowed, but it takes a human raising the limit for
              that run and saying why.
            </td>
          </tr>
          <tr>
            <th scope="row">Plausibility</th>
            <td>
              The checks that catch a parse that is wrong rather than absent —
              a currency that moved for a whole brand, a suspicious cluster of
              volumes that look computed rather than stated, densities that no
              real bag has.
            </td>
          </tr>
        </tbody>
      </table>
      <p class="note">
        A rejected night publishes nothing and keeps yesterday's catalogue
        live, which is always the better of the two outcomes: stale data is
        visibly a day old, and wrong data looks exactly like right data. The
        price ledger is banked before the gate runs regardless, because it is
        the one record that cannot be reconstructed later.
      </p>
    </section>

    <section>
      <h2>What is held back</h2>
      <p class="note">
        {fmt(indexable)} of the {fmt(bags.length)} model pages are offered to
        search engines. The rest are published, linked and identical to look
        at, but marked not to be indexed until they carry either a set of
        dimensions or a volume and a weight together. A page showing a name, a
        price and a column of dashes is not worth arriving on from a search
        result, and saying so is cheaper than letting someone find out by
        clicking. Pages cross that line as the data arrives.
      </p>
    </section>

    <section>
      <h2>What this is not</h2>
      <p class="note">
        Not a shop — nothing is sold here and there is no stock, no basket and
        no checkout. Not a review site: there are no ratings, no scores and no
        star counts anywhere in the index, because we have not tested these
        bags and a rating we did not earn is worse than none. Not a
        rewriter of marketing copy — the index holds facts, and the brand's
        description of its own bag stays on the brand's page, where the buy
        button also goes.
      </p>
    </section>

    <section>
      <h2>Corrections</h2>
      <p class="note">
        If a figure here disagrees with the one on your own product page, the
        product page is right and this is a bug worth reporting. Write to
        {' '}<a href={`mailto:${CONTACT.general}`}>{CONTACT.general}</a>. If
        you operate a store and would rather not be included at all, write to
        {' '}<a href={`mailto:${CONTACT.crawler}`}>{CONTACT.crawler}</a>, and
        {' '}<a href="/bot/">the crawler page</a> explains how to say so in
        {' '}<code>robots.txt</code> instead.
      </p>
    </section>

    {built && (
      <p class="note foot">
        Figures on this page are read from the catalogue itself and describe
        the build of {built}.
      </p>
    )}
  </div>
</Base>
