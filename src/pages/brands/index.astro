---
import Base from '../../layouts/Base.astro';
import { brands, meta } from '../../lib/catalog.js';
import { SITE_NAME_DISPLAY } from '../../lib/brand.js';
import { fmtPrice } from '../../lib/format.js';

const title = `Brands — ${SITE_NAME_DISPLAY}`;
const description =
  `Every brand in the index: ${brands.length} makers, ` +
  `${meta.bag_count ?? 0} models, ${meta.sku_count ?? 0} SKUs.`;
---
<Base title={title} description={description}>
  <div class="page">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Bags</a> <span>/</span> <b>Brands</b>
    </nav>
    <h1>Brands</h1>
    <p class="note">
      {brands.length} brands with at least one model in the index. Coverage
      grows as more storefronts are resolved and crawled.
    </p>
    {/* Above the list rather than under it. This is the page someone lands on
        to check whether their maker is here, and the ones who find out it is
        not have no reason to reach the bottom of an alphabet of everyone
        else. Ships hidden and is revealed by request-brand.js. */}
    <p class="reqrow">
      <button class="btn" type="button" data-request-brand hidden>Request a brand</button>
      <span>Missing one? Tell us which — the most-asked-for get crawled first.</span>
    </p>
    {/* 147 makers in one alphabetical column, and until now the only way to
        find one was the browser's own find-in-page. Every other list on the
        site can be narrowed where it stands — the rail has a box for exactly
        this, and each brand's own page carries the search field in its header
        — so this was the one place you could arrive knowing the name you
        wanted and still have to scroll for it.

        Ships hidden and is revealed by the script below, the same way the
        saved-filters panel and the request-brand button are: it filters the
        list by hiding rows, which nothing can do with scripting off, and a box
        that silently ignores what you type into it is worse than no box. */}
    <div class="brandfind" id="brandfind" hidden>
      <input id="brandq" type="search" autocomplete="off" spellcheck="false"
             placeholder="filter brands…" aria-label="Filter brands by name"
             aria-controls="brandlist" />
      <span class="brandfindcount" id="brandcount" role="status" aria-live="polite"></span>
    </div>
    <ul class="related brandlist" id="brandlist">
      {brands.map((brand) => {
        const prices = brand.bags.map((b) => b.price_min).filter((p) => p != null);
        return (
          <li>
            <a href={`/brands/${brand.slug}/`}>
              <b>{brand.name}</b>
              <em>
                {brand.bags.length} {brand.bags.length === 1 ? 'model' : 'models'}
                {prices.length > 0 && ` · from ${fmtPrice(Math.min(...prices), brand.bags[0]?.currency)}`}
              </em>
            </a>
          </li>
        );
      })}
    </ul>
    <p class="note" id="brandnone" hidden>
      No brand here matches that. It may still be one we have not crawled —
      the button above sends it to the list that gets picked up first.
    </p>
  </div>

  {/* Matching on the name the row shows, lowercased, with no fuzziness: this
      is a list of proper nouns someone already knows the spelling of, and the
      useful behaviour is that typing "ab" leaves Able Carry and nothing else.
      The rows are hidden rather than removed so that clearing the box costs
      nothing and the DOM never has to be rebuilt.

      data-name is read off the row rather than recomputed from textContent,
      which also carries the model count and the price and would match "12". */}
  <script is:inline>
    (() => {
      const box = document.getElementById('brandfind');
      const input = document.getElementById('brandq');
      const list = document.getElementById('brandlist');
      const none = document.getElementById('brandnone');
      const count = document.getElementById('brandcount');
      if (!box || !input || !list) return;
      box.hidden = false;

      const rows = [...list.children].map((li) => ({
        li, name: (li.querySelector('b')?.textContent || '').toLowerCase(),
      }));

      const apply = () => {
        const q = input.value.trim().toLowerCase();
        let shown = 0;
        for (const row of rows) {
          const hit = !q || row.name.includes(q);
          row.li.hidden = !hit;
          if (hit) shown++;
        }
        if (none) none.hidden = shown > 0;
        if (count) count.textContent = q ? shown + ' of ' + rows.length : '';
      };

      input.addEventListener('input', apply);
      // Escape clears rather than only blurring, which is what a type-to-narrow
      // box is expected to do and saves selecting the text to delete it.
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') { input.value = ''; apply(); }
      });
      apply();
    })();
  </script>
</Base>
