---
/* A brand's shelf: the browse instrument, pointed at one maker.
 *
 * This was a six-column table of every model, which is the right page for a
 * brand holding eight bags and the wrong one for Dakine, which holds 597. A
 * reader arriving here wants the same three questions the front page answers —
 * how big, how heavy, how much — and they were being handed a spreadsheet to
 * scroll instead of the controls that answer them.
 *
 * So it mounts the same island, with the brand already settled by the path
 * rather than ticked in the rail. That is a scope rather than a filter: it does
 * not appear in the address bar, Clear does not empty it, and the rail counts
 * against this brand's shelf rather than the catalogue — a Colour group listing
 * only the colours this brand actually sells, and a price track spanning its
 * own range rather than four thousand dollars of other people's luggage. See
 * the scope section in pages/api/browse.ts.
 *
 * The table did not go anywhere. It is the fallback inside #results, which the
 * island replaces on load — so a crawler, and anyone with no JavaScript, still
 * gets every model and every spec on one page, and the JSON-LD below still
 * describes something that is genuinely in the markup.
 */
import Base from '../../layouts/Base.astro';
import BrowseHead from '../../components/BrowseHead.astro';
import BrowseShell from '../../components/BrowseShell.astro';
import WatchForm from '../../components/WatchForm.astro';
import Measure from '../../components/Measure.astro';
import { brands, bagHref } from '../../lib/catalog.js';
import { catLabel } from '../../lib/labels.js';
import { SITE_NAME_DISPLAY } from '../../lib/brand.js';
import { fmtPrice, fmtVolume, fmtWeightBoth, fmtDims } from '../../lib/format.js';
import roster from '../../../brands.json';

export function getStaticPaths() {
  return brands.map((brand) => ({ params: { brand: brand.slug }, props: { brand } }));
}

const { brand } = Astro.props;

/* The brand's own site.
 *
 * This is the one place it belongs. It was tempting to put it on the model page
 * beside the buy button, but a link to a brand's homepage competes with that
 * button and converts worse than it: the reader who follows it has to find the
 * bag again, where the buy link lands them on the product itself. Here the
 * reader is browsing a brand rather than deciding on a bag, so the link answers
 * the question actually being asked and costs no purchase intent.
 *
 * Tracked as brand_click, never as buy_click — see scripts/analytics.js.
 */
const domain = roster.find((b) => b.slug === brand.slug)?.domain ?? null;
const prices = brand.bags.map((b) => b.price_min).filter((p) => p != null);
// Every model on this page came from one storefront, so one currency covers
// the lot. Read off the bags rather than the roster because aggregator-
// sourced brands are not in the roster at all.
const cur = brand.bags[0]?.currency ?? 'USD';
const cats = [...new Set(brand.bags.map((b) => b.category))].map(catLabel);

// The same note the front page's price slider carries, asked of one shelf. Rare
// on a brand page — one storefront usually quotes one currency — and computed
// rather than assumed so it says nothing on the brands where that holds.
const otherCurrencies = [
  ...new Set(brand.bags.map((b) => b.currency).filter((c) => c && c !== 'USD')),
].sort();

const title = `${brand.name} bags — every model, specs & prices | ${SITE_NAME_DISPLAY}`;
const description =
  `All ${brand.bags.length} ${brand.name} models in the index` +
  (prices.length ? `, from ${fmtPrice(Math.min(...prices), cur)}` : '') +
  `. Volume, weight and dimensions normalised for comparison.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${brand.name} bags`,
  description,
  url: new URL(`/brands/${brand.slug}/`, Astro.site).href,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: brand.bags.length,
    itemListElement: brand.bags.map((bag, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `${bag.brand} ${bag.name}`,
      url: new URL(bagHref(bag), Astro.site).href,
    })),
  },
};
---
<Base title={title} description={description}>
  <Fragment slot="head">
    {/* is:inline because this is data for a crawler, not code: it must ship in
        the document as written rather than be bundled and fetched. */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <BrowseHead slot="header" />

  {/* Above the shell, spanning the rail as well as the grid, where the sale
      strip sits on the front page — the shared scope bar, which /sale/ wears
      too. Everything in it is what the grid below cannot say: whose shelf this
      is, how to reach the maker, and how to be told when one of their prices
      moves. The results are an infinite scroll, so anything left underneath
      them is somewhere nobody arrives. */}
  <section class="scopebar">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Bags</a> <span>/</span>
      <a href="/brands/">Brands</a> <span>/</span>
      <b>{brand.name}</b>
    </nav>

    <div class="scopemain">
      <div class="scopeid">
        <h1>{brand.name}</h1>
        <p class="scopefacts">
          {brand.bags.length} {brand.bags.length === 1 ? 'model' : 'models'}
          {cats.length > 0 && ` · ${cats.join(', ')}`}
          {prices.length > 0 && ` · ${fmtPrice(Math.min(...prices), cur)}–${fmtPrice(Math.max(...prices), cur)}`}
          {domain && (
            <Fragment>
              {' · '}
              <a href={`https://${domain}/`} target="_blank" rel="noopener nofollow"
                 data-brandlink="brand_page"
                 data-brandlink-brand={brand.name}>{domain} ↗</a>
            </Fragment>
          )}
        </p>
      </div>

      <WatchForm brandSlug={brand.slug} name={`anything from ${brand.name}`} currency={cur} />
    </div>
  </section>

  <BrowseShell brand={{ slug: brand.slug, name: brand.name }}
               otherCurrencies={otherCurrencies}
               placeholder={`search ${brand.name} — model, material, feature…`}>
    {/* The fallback, and the crawler's copy of this page. Six columns of
        figures do not fit a phone at any padding worth having, so the table
        scrolls inside its own box rather than taking the page sideways with
        it. */}
    <div class="xscroll">
      <table class="spectable brandtable">
        <thead>
          <tr><th>Model</th><th>Category</th><th>Volume</th><th>Weight</th><th>H×W×D</th><th>Price</th></tr>
        </thead>
        <tbody>
          {brand.bags.map((bag) => (
            <tr>
              <td><a href={bagHref(bag)}>{bag.name}</a></td>
              <td>{catLabel(bag.category)}</td>
              <td class={bag.volume_l == null ? 'nil' : ''}>{fmtVolume(bag.volume_l) ?? '—'}</td>
              <td class={bag.weight_g == null ? 'nil' : ''}><Measure value={fmtWeightBoth(bag.weight_g)} /></td>
              <td class={bag.dims_cm == null ? 'nil' : ''}><Measure value={fmtDims(bag.dims_cm)} /></td>
              <td>{fmtPrice(bag.price_min, bag.currency)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </BrowseShell>

  <script>
    import '../../scripts/browse.js';
  </script>
</Base>
