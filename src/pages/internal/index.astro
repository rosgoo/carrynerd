---
import Base from '../../layouts/Base.astro';
import { bags, bagHref, meta } from '../../lib/catalog.js';
import { SITE_NAME_DISPLAY } from '../../lib/brand.js';
import { guard } from '../../lib/dash.ts';
import type { Bag, RejectedPayload, Variant } from '../../lib/types.d.ts';
import rawRejected from '../../../data/rejected.json';
import colourOverrides from '../../../data/colour-overrides.json';
import categoryOverrides from '../../../data/category-overrides.json';

/* Like bags.json, too large for TypeScript to infer a shape from — it arrives
   as `any`. The shape it actually has is in types.d.ts. */
const rejectedPayload = rawRejected as RejectedPayload;

/* Behind the password now, and therefore rendered per request rather than
 * built. It was unlinked and noindex before, which is not the same thing: this
 * page lists what the index declined to claim, and that is a working weakness
 * rather than a public one. Nothing about the page itself changes. */
export const prerender = false;
const denied = await guard(Astro);
if (denied) return denied;

/* The working list behind the coverage banners.
 *
 * Two audits, one page, because they are the same question asked at two points
 * in the pipeline: what did we decline to claim? Colour classification is the
 * gap inside the index; the reject list is the gap at its edge — the products
 * normalize.py refused to admit at all.
 *
 * Unlinked, noindex and out of the sitemap. A working list, not a page.
 */

/* ---------- reviewed rulings ----------
 *
 * The same two files normalize.py consults, read here so the audit list can
 * separate "nobody has looked at this" from "somebody looked and this is the
 * answer". The matching rules have to agree with the Python exactly: content
 * keys, whitespace-collapsed and case-folded; products keyed on the last path
 * segment of their URL.
 */

const normKey = (s: unknown) =>
  String(s ?? '').replace(/\s+/g, ' ').trim().toLowerCase();

const productKey = (url: unknown) =>
  normKey(
    String(url ?? '').replace(/[?#].*$/, '').replace(/\/+$/, '').split('/').pop(),
  );

/** What one ruling says: a family or category, or null for "reviewed, and the
 *  answer is genuinely nothing". */
type Ruling = string | null;

/* Every ruling in one of the override files, as [brand slug, key, ruling].
 *
 * The files are hand-edited, so they are read as `unknown` and narrowed here
 * rather than trusted: the `_`-prefixed keys are notes to whoever opens the
 * file rather than brands, and skipping them is a rule the three readers below
 * would otherwise each restate. Written as one pass because a file holding
 * only its notes — which is the state both files ship in — otherwise infers a
 * ruling type from the `_example` block. */
function* eachRuling(payload: unknown): Generator<[string, string, Ruling]> {
  const file = (payload ?? {}) as Record<string, unknown>;
  for (const [brand, entries] of Object.entries(file)) {
    if (brand.startsWith('_') || typeof entries !== 'object' || entries === null) {
      continue;
    }
    for (const [key, value] of Object.entries(entries)) {
      yield [brand, key, typeof value === 'string' ? value : null];
    }
  }
}

/** brand + key -> ruling, skipping the `_`-prefixed notes in the file. */
function rulings(payload: unknown) {
  const out = new Map<string, Ruling>();
  for (const [brand, key, value] of eachRuling(payload)) {
    out.set(`${brand}|${normKey(key)}`, value);
  }
  return out;
}

const BRAND_NAMES = new Map(bags.map((b) => [b.brand_slug, b.brand]));
const brandName = (slug: string) => BRAND_NAMES.get(slug) ?? slug;

const COLOUR_RULINGS = rulings(colourOverrides);
const CATEGORY_RULINGS = rulings(categoryOverrides);
const ruled = (map: Map<string, Ruling>, brand: string, key: unknown) =>
  map.has(`${brand}|${normKey(key)}`);

/* Written by normalize.py, so it is absent until the pipeline has run since
   the override files appeared. Absent is reported as absent — the one thing
   this page must not do is imply a clean bill of health it cannot see. */
const overrideReport = meta.overrides ?? null;

/* ---------- colour classification ---------- */

const rows = [];
for (const bag of bags) {
  const seen = new Set();
  for (const v of bag.variants ?? []) {
    if (v.color_family) continue;
    const name = (v.color ?? '').trim();
    seen.add(name);
    rows.push({ bag, name, sku: v.sku, title: v.title });
  }
  /* A merged model can carry a colourway recovered from a sibling product's
     title with no variant of its own. Those names are not classified per-SKU,
     so they are only visible here — and only safely: when the bag has no
     families at all, every name on it failed by definition. */
  if (!(bag.color_families ?? []).length) {
    for (const c of bag.colors ?? []) {
      const name = (c ?? '').trim();
      if (name && !seen.has(name)) rows.push({ bag, name, sku: null, title: null });
    }
  }
}

/* Names that state no colour, grouped by brand and name — the same unit a
   ruling is written in, because these names are not global. Case-folded:
   "X-Pac" and "X-PAC" are one problem, not two. */
const byName = new Map();
for (const row of rows.filter((r) => r.name)) {
  const key = `${row.bag.brand_slug} ${normKey(row.name)}`;
  let entry = byName.get(key);
  if (!entry) {
    byName.set(
      key,
      (entry = {
        name: row.name,
        brand: row.bag.brand,
        brandSlug: row.bag.brand_slug,
        skus: 0,
        bags: new Map(),
        decided: ruled(COLOUR_RULINGS, row.bag.brand_slug, row.name),
      }),
    );
  }
  entry.skus += 1;
  entry.bags.set(row.bag.id, row.bag);
}
const names = [...byName.values()].sort(
  (a, b) => b.skus - a.skus || a.name.localeCompare(b.name),
);
/* The top table is work; a name with a ruling has already had its turn. A name
   ruled a *family* also stops being unclassified once the pipeline has run, so
   it leaves this list on its own — until then it sits in both, which is why
   the table below reports what the data currently says rather than inferring
   the ruling from the fact that the name is still here. */
const unreviewedNames = names.filter((n) => !n.decided);

/* Every ruling, read back out of the file and checked against the catalog: how
   many SKUs it matches, and whether the built data actually reflects it. A
   ruling recorded but not yet run is the normal state right after editing the
   file, and saying so beats showing a number that means neither thing. */
const decidedColours = [];
for (const [brand, name, family] of eachRuling(colourOverrides)) {
  const matched: Variant[] = [];
  for (const bag of bags) {
    if (bag.brand_slug !== brand) continue;
    for (const v of bag.variants ?? []) {
      if (normKey(v.color) === normKey(name)) matched.push(v);
    }
  }
  decidedColours.push({
    brand: brandName(brand),
    name,
    family,
    skus: matched.length,
    // `family` is a string or null, and `color_family` is the same shape, so
    // this compares like with like in both directions.
    applied: matched.length > 0
      && matched.every((v) => (v.color_family ?? null) === family),
  });
}
decidedColours.sort(
  (a, b) => a.brand.localeCompare(b.brand) || a.name.localeCompare(b.name),
);

/* Paste-ready skeleton for everything still unreviewed. The placeholder is
   deliberately not a valid family: paste it unedited and normalize.py stops
   with the list of families it accepts, rather than silently recording a
   ruling nobody made. */
const skeleton = (entries: [string, string][]) => {
  const out: Record<string, Record<string, string>> = {};
  for (const [brand, key] of entries) (out[brand] ??= {})[key] = '?';
  return JSON.stringify(out, null, 1);
};
const colourSkeleton = skeleton(
  unreviewedNames.map((n): [string, string] => [n.brandSlug, n.name]),
);

// Models the brand ships without any colourway.
const silent = bags
  .filter((b) => !(b.colors ?? []).length && !(b.variants ?? []).some((v) => v.color))
  .map((b) => ({
    bag: b,
    options: [
      ...new Set(
        (b.variants ?? [])
          .map((v) => (v.title ?? '').trim())
          .filter((t) => t && t !== 'Default Title'),
      ),
    ],
  }))
  .sort(
    (a, b) =>
      a.bag.brand.localeCompare(b.bag.brand) || a.bag.name.localeCompare(b.bag.name),
  );

// The banner's own number: bags no colour filter can ever return.
const invisible = bags.filter((b) => !(b.color_families ?? []).length);
const namedInvisible = invisible.length - silent.length;

// Models that do answer a colour filter but still hold an unclassified SKU —
// reachable, but not under the colourway a reader would be looking for.
const partial = bags.filter(
  (b) =>
    (b.color_families ?? []).length &&
    (b.variants ?? []).some((v) => v.color && !v.color_family),
);

const skuTotal = bags.reduce((n, b) => n + (b.variant_count ?? 0), 0);

const modelLinks = (list: Bag[]) =>
  [...list].sort(
    (a, b) => a.brand.localeCompare(b.brand) || a.name.localeCompare(b.name),
  );

/* ---------- rejected products ---------- */

const REASON_NOTES: Record<string, string> = {
  unclassified:
    'looks like carry, but no category pattern matched its title, its shelving or its tags',
  'unclassified:known-bag':
    'the brand’s own shelving says it is a bag and we still could not say which kind — the genuine misses',
  'not-a-bag': 'the title or product_type matched the exclusion list',
  'not-a-bag:collection': 'the brand shelved it somewhere that is not carry',
  'not-a-bag:product-type': 'the store filed it under a type that is not carry',
};

const rejected = (rejectedPayload.rejected ?? [])
  .map((r) => ({
    ...r,
    brand: brandName(r.brand_slug),
    inCatalog: BRAND_NAMES.has(r.brand_slug),
    key: productKey(r.url),
    /* The ruling is joined here rather than trusted from the file:
       rejected.json only carries `reviewed` if it was written after the
       override files existed, and the override file is right here. */
    decided: ruled(CATEGORY_RULINGS, r.brand_slug, productKey(r.url)),
  }))
  .sort(
    (a, b) =>
      a.brand.localeCompare(b.brand) ||
      a.reason.localeCompare(b.reason) ||
      (a.title ?? '').localeCompare(b.title ?? ''),
  );

const reasonCount = new Map<string, number>();
for (const r of rejected) reasonCount.set(r.reason, (reasonCount.get(r.reason) ?? 0) + 1);
const rejectReasons = [...reasonCount.keys()].sort(
  (a, b) => (reasonCount.get(b) ?? 0) - (reasonCount.get(a) ?? 0),
);
const inCatalogRejects = rejected.filter((r) => r.inCatalog).length;
const decidedRejects = rejected.filter((r) => r.decided).length;
const otherBrands = new Set(
  rejected.filter((r) => !r.inCatalog).map((r) => r.brand_slug),
);

/* Products a ruling pulled back in are no longer rejected, so they are read
   out of the file the same way applied colours are. */
const admitted = [];
for (const [brand, key, category] of eachRuling(categoryOverrides)) {
  if (category == null) continue;
  const bag = bags.find(
    (b) => b.brand_slug === brand && productKey(b.url) === normKey(key),
  );
  admitted.push({ brand: brandName(brand), key, category, bag: bag ?? null });
}
admitted.sort((a, b) => a.brand.localeCompare(b.brand) || a.key.localeCompare(b.key));

/* The two files are written by different steps of the same night: the reject
   list covers everything the crawl saw, the catalog only the brands we
   publish. Say which, rather than letting the totals quietly disagree with the
   meta block. */
const stamp = (s: string | null) => (s ? s.replace('T', ' ').replace('Z', ' UTC') : '—');
const rejectStamp = rejectedPayload.generated_at ?? null;
const catalogStamp = meta.generated_at ?? null;
---
<Base
  title={`Coverage audit — internal — ${SITE_NAME_DISPLAY}`}
  description="Internal audit of unclassified colourways and rejected products."
  noindex={true}
>
  <div class="page">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Bags</a> <span>/</span> <b>Internal · coverage audit</b>
      <span>·</span> <a href="#colours">Colours</a>
      <span>·</span> <a href="#rejects">Rejects</a>
      <span>·</span> <a href="/internal/domains/">Domains</a>
      <span>·</span> <a href="/internal/requests/">Requests</a>
      <span>·</span> <a href="/internal/email/">Email</a>
      {/* Referrals was the one internal page nothing linked to. It is reachable
          from /internal/email/ and /internal/requests/ and from neither of the
          other two, which made the dashboard the only page that could not
          reach the number the whole index is trying to earn. */}
      <span>·</span> <a href="/internal/referrals/">Referrals</a>
    </nav>
    <h1>Coverage audit</h1>
    <p class="note">
      What the index declined to claim, at both ends of the pipeline: the
      colourways inside it that map to no colour, and the products that never
      got in. Generated from <code>data/bags.json</code> and
      {' '}<code>data/rejected.json</code> at build time, so the page itself
      writes nothing — a ruling is a line in
      {' '}<code>data/colour-overrides.json</code> or
      {' '}<code>data/category-overrides.json</code> and a re-run of
      {' '}<code>normalize.py</code>, which consults both before its own
      patterns. Each table below hands you the line to paste.
    </p>
    {!overrideReport && (
      <p class="note warnrun">
        <b>bags.json predates the override files.</b> Nothing is wrong — the
        rulings just have not been through the pipeline yet, so the stale-ruling
        report below is empty because it has never been written, not because
        there is nothing to report. Run <code>python3 normalize.py</code>.
      </p>
    )}

    <section>
      <h2 id="colours">Colour classification</h2>
      <p class="note">
        Every SKU whose colourway name mapped to no colour family, which is
        what the browse banner is counting when a colour filter is on.
        {' '}<b>{invisible.length}</b> of {bags.length} models answer no colour
        filter at all: <b>{namedInvisible}</b> publish a name that states no
        colour, and <b>{silent.length}</b> publish no colourway at all. A
        further <b>{partial.length}</b> models are filterable but still hold an
        unclassified SKU. Nothing here is a wrong colour — it is the set we
        have not claimed a colour for.
      </p>
    </section>

    <section>
      <h2>Names that state no colour — unreviewed</h2>
      <p class="note">
        <b>{unreviewedNames.length}</b> brand-and-name pairs nobody has ruled
        on, across <b>{unreviewedNames.reduce((n, e) => n + e.skus, 0)}</b> SKUs
        of {skuTotal}. A name here is a gap only if it really does name a colour
        — a material ("X-Pac", "Heritage Suede") or a collab name correctly maps
        to nothing, and ruling it <code>null</code> is how you say so and get it
        off this list.
      </p>
      {unreviewedNames.length === 0 ? (
        <p class="note">
          Nothing unreviewed. Every unclassified colourway name has a ruling.
        </p>
      ) : (
        <>
          <table class="spectable brandtable">
            <thead>
              <tr><th>Brand</th><th>Colourway</th><th>SKUs</th><th>Models</th></tr>
            </thead>
            <tbody>
              {unreviewedNames.map((entry) => (
                <tr>
                  <td>{entry.brand}</td>
                  <td>{entry.name}</td>
                  <td>{entry.skus}</td>
                  <td class="modelcell">
                    {modelLinks(entry.bags.values()).map((bag, i) => (
                      <>
                        {i > 0 && <span class="nil">, </span>}
                        <a href={bagHref(bag)}>{bag.brand} {bag.name}</a>
                        {!(bag.color_families ?? []).length && (
                          <span class="nil" title="answers no colour filter"> ∅</span>
                        )}
                      </>
                    ))}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          <div class="paste">
            <div class="pastebar">
              <em>Paste into <code>data/colour-overrides.json</code></em>
              <button class="tbtn" data-copy="colour-skeleton">Copy</button>
            </div>
            <pre id="colour-skeleton">{colourSkeleton}</pre>
            <p class="note foot">
              Replace each <code>"?"</code> with a family — black, blue, brown,
              green, grey, multi, orange, pink, purple, red, white, yellow — or
              with <code>null</code> for "reviewed, states no colour".
              {' '}<code>"?"</code> is not a valid family on purpose: leave one
              in and <code>normalize.py</code> stops and tells you, rather than
              recording a ruling you did not make.
            </p>
          </div>
        </>
      )}
      <p class="note foot">
        <span class="nil">∅</span> marks a model with no colour family at all —
        it is missing from every colour filter, not just this colourway.
      </p>
    </section>

    {decidedColours.length > 0 && (
      <section>
        <h2>Colourways already ruled on</h2>
        <p class="note">
          From <code>data/colour-overrides.json</code>, checked against the
          catalog as built. A ruling matching <b>0</b> SKUs has gone stale; one
          matching SKUs the data does not agree with is simply waiting on a
          re-run of <code>normalize.py</code>.
        </p>
        <table class="spectable brandtable">
          <thead>
            <tr><th>Brand</th><th>Colourway</th><th>Ruling</th><th>SKUs</th><th>In the data</th></tr>
          </thead>
          <tbody>
            {decidedColours.map((entry) => (
              <tr>
                <td>{entry.brand}</td>
                <td>{entry.name}</td>
                <td class={entry.family ? 'mono' : 'mono nil'}>
                  {entry.family ?? 'states no colour'}
                </td>
                <td class={entry.skus ? '' : 'nil'}>{entry.skus}</td>
                <td class={entry.applied ? '' : 'nil'}>
                  {entry.applied
                    ? 'applied'
                    : entry.skus
                      ? 'pending a re-run'
                      : 'nothing matches'}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    )}

    <section>
      <h2>Models with no colourway published</h2>
      <p class="note">
        <b>{silent.length}</b> models whose feed states no colour on any
        variant. There is nothing to classify: the brand never said. Listed so
        the count above reconciles, and so a brand that turns out to publish
        colours somewhere else on the page is visible as a fetch gap rather
        than a classifier one.
      </p>
      {silent.length > 0 && (
        <table class="spectable brandtable">
          <thead>
            <tr><th>Model</th><th>SKUs</th><th>Variant options</th><th>Source</th></tr>
          </thead>
          <tbody>
            {silent.map(({ bag, options }) => (
              <tr>
                <td><a href={bagHref(bag)}>{bag.brand} {bag.name}</a></td>
                <td>{bag.variant_count ?? 0}</td>
                <td class="mono">{options.length ? options.join(' · ') : '—'}</td>
                <td class="mono"><a href={bag.url} rel="nofollow noopener">feed</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </section>

    {partial.length > 0 && (
      <section>
        <h2>Partially classified models</h2>
        <p class="note">
          These answer a colour filter on their other colourways, so the banner
          never mentions them — but the SKUs listed above under this model
          cannot be reached by colour.
        </p>
        <table class="spectable brandtable">
          <thead>
            <tr><th>Model</th><th>Families</th><th>Unclassified SKUs</th></tr>
          </thead>
          <tbody>
            {partial.map((bag) => (
              <tr>
                <td><a href={bagHref(bag)}>{bag.brand} {bag.name}</a></td>
                <td class="mono">{(bag.color_families ?? []).join(' · ')}</td>
                <td class="mono">
                  {[
                    ...new Set(
                      (bag.variants ?? []).flatMap((v) =>
                        v.color && !v.color_family ? [v.color.trim()] : [],
                      ),
                    ),
                  ].join(' · ')}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    )}

    <section>
      <h2 id="rejects">Rejected products</h2>
      <p class="note">
        <b>{rejected.length}</b> products <code>normalize.py</code> declined to
        index, with the reason it recorded. <b>{inCatalogRejects}</b> belong to
        the {meta.brand_count ?? 0} brands the published catalog covers — that
        is exactly the number in its <code>meta.rejected</code> block. The
        other <b>{rejected.length - inCatalogRejects}</b> are from
        {' '}{otherBrands.size} brands the index does not show yet: the reject
        list is written by the crawl, and the crawl is wider than the catalog
        we publish. Reject list <b>{stamp(rejectStamp)}</b>, catalog
        {' '}<b>{stamp(catalogStamp)}</b>.
      </p>
      <ul class="note reasons">
        {rejectReasons.map((reason) => (
          <li>
            <code>{reason}</code> <b>{reasonCount.get(reason)}</b>
            {REASON_NOTES[reason] && <> — {REASON_NOTES[reason]}</>}
          </li>
        ))}
      </ul>

      <div class="rjbar">
        <div class="chips">
          {rejectReasons.map((reason) => (
            <button class="chip" data-reason={reason} aria-pressed="true">
              {reason}<span>{reasonCount.get(reason)}</span>
            </button>
          ))}
          <button class="chip" id="rj-catalog" aria-pressed="false">
            catalog brands only<span>{inCatalogRejects}</span>
          </button>
          <button class="chip" id="rj-unreviewed" aria-pressed="false">
            unreviewed only<span>{rejected.length - decidedRejects}</span>
          </button>
        </div>
        <input id="rj-q" type="search" placeholder="filter title, brand, type, tag…" />
        <span class="count" id="rj-count"><b>{rejected.length}</b> shown</span>
        <button class="tbtn" id="rj-skeleton">Copy filtered as rulings</button>
      </div>
      <div class="tablewrap rjwrap">
        <table class="spectable brandtable rjtable">
          <thead>
            <tr>
              <th>Brand</th><th>Title</th><th>product_type</th><th>Tags</th>
              <th>Reason</th>
            </tr>
          </thead>
          <tbody>
            {rejected.map((r) => (
              <tr
                data-reason={r.reason}
                data-cat={r.inCatalog ? '1' : '0'}
                data-ruled={r.decided ? '1' : '0'}
                data-brand={r.brand_slug}
                data-key={r.key}
                class={r.decided ? 'ruled' : undefined}
              >
                <td>
                  {r.brand}
                  {!r.inCatalog && (
                    <span class="nil" title="brand not in the published catalog"> ∅</span>
                  )}
                  {r.decided && (
                    <span class="nil" title="ruled on: correctly rejected"> ✓</span>
                  )}
                </td>
                <td class="rjtitle">
                  {r.url
                    ? <a href={r.url} rel="nofollow noopener">{r.title ?? r.url}</a>
                    : (r.title ?? '—')}
                </td>
                <td class="mono">{r.product_type || '—'}</td>
                <td class="mono rjtags">
                  {(r.tags ?? []).length
                    ? r.tags.length > 5
                      ? `${r.tags.slice(0, 5).join(' · ')} +${r.tags.length - 5}`
                      : r.tags.join(' · ')
                    : '—'}
                </td>
                <td class="mono">{r.reason}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="paste">
        <div class="pastebar">
          <em>Rulings for the rows you have filtered to</em>
        </div>
        <pre id="rj-skeleton-out" class="nil">Filter the table, then press “Copy filtered as rulings”.</pre>
        <p class="note foot">
          Values are <code>"?"</code> — replace each with a category (briefcase,
          camera-bag, daypack, duffel, hiking-pack, hip-pack, luggage,
          messenger, pouch, sling, tote, travel-backpack) to pull the product
          into the index, or with <code>null</code> to record that it is
          correctly rejected. A category ruling overrides the not-a-bag rules
          outright and the model page will read
          {' '}<code>category_source: override</code>.
        </p>
      </div>
      <p class="note foot">
        <span class="nil">∅</span> marks a brand with nothing in the published
        catalog, <span class="nil">✓</span> a row someone has already ruled on;
        each title links to the product it was rejected from. Filtering is
        client-side over the whole list, so with scripting off the table is
        simply all {rejected.length} rows.
      </p>
    </section>

    {admitted.length > 0 && (
      <section>
        <h2>Products ruled back in</h2>
        <p class="note">
          From <code>data/category-overrides.json</code>. These are not in the
          reject list any more — that is the ruling working — so they are read
          back out of the file and matched against the catalog.
        </p>
        <table class="spectable brandtable">
          <thead>
            <tr><th>Brand</th><th>Product key</th><th>Category</th><th>In the index</th></tr>
          </thead>
          <tbody>
            {admitted.map((entry) => (
              <tr>
                <td>{entry.brand}</td>
                <td class="mono">{entry.key}</td>
                <td class="mono">{entry.category}</td>
                <td>
                  {entry.bag
                    ? <a href={bagHref(entry.bag)}>{entry.bag.name}</a>
                    : <span class="nil">no match — stale, or not rebuilt yet</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    )}

    <section>
      <h2>Stale rulings</h2>
      {!overrideReport ? (
        <p class="note">
          Not written yet — <code>normalize.py</code> has not run since the
          override files appeared. It records which rulings it consulted; a
          ruling nothing matched is the one kind of rot this page cannot see
          from the built data alone, because the product it was about is gone.
        </p>
      ) : (
        <>
          <p class="note">
            Rulings that matched nothing on the last pipeline run — a product
            the brand stopped selling, a colourway they renamed. Prune them, or
            they quietly become fiction.
          </p>
          <table class="spectable brandtable">
            <thead>
              <tr><th>File</th><th>Rulings</th><th>Used</th><th>Stale</th></tr>
            </thead>
            <tbody>
              {Object.entries(overrideReport).map(([kind, report]) => (
                <tr>
                  <td class="mono">{report.file ?? kind}</td>
                  <td>{report.entries ?? 0}</td>
                  <td>{report.used ?? 0}</td>
                  <td class={report.stale?.length ? '' : 'nil'}>
                    {report.stale?.length
                      ? report.stale.map((s) => `${s.brand}/${s.key}`).join(' · ')
                      : 'none'}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </>
      )}
    </section>
  </div>
</Base>

<script>
  /* Filtering over a table that is already fully rendered. The list is a few
     thousand static rows, so shipping it whole and hiding rows beats
     fetch-and-render: it works with scripting off, and there is no second copy
     of the data to keep in step. */
  /* Each of these is rendered by the markup above, so a miss is this file
     disagreeing with itself rather than a state the page has to cope with.
     Checked rather than asserted, because the kind matters as much as the
     presence: the query box is read for its `.value`. */
  const need = <T extends HTMLElement>(id: string, kind: new () => T): T => {
    const el = document.getElementById(id);
    if (!(el instanceof kind)) {
      throw new Error(`#${id} is not the ${kind.name} this script expects`);
    }
    return el;
  };

  const table = document.querySelector<HTMLTableElement>('.rjtable');
  if (table) {
    const rows = [...table.tBodies[0].rows].map((el) => ({
      el,
      reason: el.dataset.reason ?? '',
      inCatalog: el.dataset.cat === '1',
      ruled: el.dataset.ruled === '1',
      brand: el.dataset.brand ?? '',
      key: el.dataset.key ?? '',
      text: (el.textContent ?? '').toLowerCase(),
    }));
    const chips = [
      ...document.querySelectorAll<HTMLElement>('.rjbar .chip[data-reason]'),
    ];
    const catalogOnly = need('rj-catalog', HTMLButtonElement);
    const unreviewedOnly = need('rj-unreviewed', HTMLButtonElement);
    const query = need('rj-q', HTMLInputElement);
    const count = need('rj-count', HTMLElement);
    let visible = rows;

    const apply = () => {
      const on = new Set(
        chips
          .filter((c) => c.getAttribute('aria-pressed') === 'true')
          .map((c) => c.dataset.reason ?? ''),
      );
      const cat = catalogOnly.getAttribute('aria-pressed') === 'true';
      const fresh = unreviewedOnly.getAttribute('aria-pressed') === 'true';
      const q = query.value.trim().toLowerCase();
      visible = [];
      for (const row of rows) {
        const hit =
          on.has(row.reason) &&
          (!cat || row.inCatalog) &&
          (!fresh || !row.ruled) &&
          (!q || row.text.includes(q));
        row.el.hidden = !hit;
        if (hit) visible.push(row);
      }
      count.innerHTML = `<b>${visible.length}</b> shown`;
    };

    for (const chip of [...chips, catalogOnly, unreviewedOnly]) {
      chip.addEventListener('click', () => {
        chip.setAttribute(
          'aria-pressed',
          chip.getAttribute('aria-pressed') === 'true' ? 'false' : 'true',
        );
        apply();
      });
    }
    let timer: ReturnType<typeof setTimeout> | undefined;
    query.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(apply, 90);
    });

    /* The skeleton is built from what is on screen, so the filter *is* the
       selection: narrow to one brand and one reason, then paste that. */
    const out = need('rj-skeleton-out', HTMLElement);
    const skeletonButton = need('rj-skeleton', HTMLButtonElement);
    skeletonButton.addEventListener('click', () => {
      if (!visible.length) {
        out.textContent = 'Nothing shown — widen the filter first.';
        return;
      }
      const shape: Record<string, Record<string, string>> = {};
      for (const row of visible) (shape[row.brand] ??= {})[row.key] = '?';
      const text = JSON.stringify(shape, null, 1);
      out.textContent = text;
      out.classList.remove('nil');
      copy(text, skeletonButton);
    });
  }

  /* Clipboard writes need a secure context, which localhost has and a LAN
     address does not. Say when it failed rather than leaving a button that
     looks like it worked — the text is on screen and selectable either way. */
  async function copy(text: string, button: HTMLElement) {
    const said = button.textContent;
    try {
      await navigator.clipboard.writeText(text);
      button.textContent = 'Copied';
    } catch {
      button.textContent = 'Select it and copy';
    }
    setTimeout(() => { button.textContent = said; }, 1600);
  }

  for (const button of document.querySelectorAll<HTMLElement>('[data-copy]')) {
    button.addEventListener('click', () => {
      const id = button.dataset.copy;
      const target = id ? document.getElementById(id) : null;
      if (target) copy(target.textContent ?? '', button);
    });
  }
</script>

<style>
  /* The model column is a prose list of links, not a figure — let it wrap and
     drop the tabular font the spec tables use. */
  .modelcell { font-family: inherit; white-space: normal; line-height: 1.7; }
  .modelcell a { margin-right: 1px; }
  code { font-family: var(--mono); font-size: .92em; color: var(--ink-dim); }

  .reasons { list-style: none; margin: 0; padding: 0 14px 12px; }
  .reasons li { padding: 2px 0; }
  .reasons b { color: var(--ink); font-variant-numeric: tabular-nums; }

  .rjbar {
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
    padding: 10px 14px; border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .rjbar .chips { flex-wrap: wrap; }
  .rjbar input {
    flex: 1; min-width: 180px; background: var(--panel);
    border: 1px solid var(--line-2); color: var(--ink);
    padding: 4px 8px; font-size: 11px;
  }
  .rjbar input:focus { border-color: var(--accent); outline: none; }

  /* The reject list is long by design — cap it and scroll, rather than making
     every visit a several-thousand-row page scroll. */
  .rjwrap { max-height: 72vh; overflow-y: auto; padding-bottom: 0; }
  .rjtable thead th { position: sticky; top: 0; z-index: 1; }
  /* The filter hides rows with [hidden]; the UA rule for it is weak enough
     that any author `display` on a row would beat it. Say it outright. */
  .rjtable tbody tr[hidden] { display: none; }
  /* Six columns of mostly-short strings: tighten the spec-table padding so the
     reason and the link stay on screen at a laptop width instead of hiding
     behind a horizontal scroll. */
  .rjtable th, .rjtable td { padding: 5px 10px; }
  .rjtitle { font-family: inherit; white-space: normal; min-width: 170px; }
  .rjtags {
    max-width: 190px; overflow: hidden; text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* A row someone has already ruled on stays in place — the list is an audit
     trail, not a queue — but it should not compete for attention. */
  .rjtable tbody tr.ruled td { opacity: .55; }

  .warnrun { border-left: 2px solid var(--accent); }

  .paste { border-top: 1px solid var(--line); }
  .pastebar {
    display: flex; align-items: center; gap: 10px;
    padding: 8px 14px 6px;
  }
  .pastebar em {
    font-style: normal; font-size: 9.5px; letter-spacing: .08em;
    text-transform: uppercase; color: var(--ink-mute);
  }
  .paste pre {
    margin: 0; padding: 0 14px 12px; overflow-x: auto;
    font-family: var(--mono); font-size: 11px; line-height: 1.55;
    color: var(--ink-dim);
  }
</style>
