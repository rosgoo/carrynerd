---
import Base from '../layouts/Base.astro';
import { hubs } from '../lib/hubs.js';
import { SITE_NAME_DISPLAY } from '../lib/brand.js';

/* The page for a URL that does not exist.
 *
 * The build is static, so this is the whole handler: Astro writes
 * dist/client/404.html and Vercel serves it for any path that generated no
 * page. Nothing routes to it and nothing links to it, which is exactly why it
 * had to be written on purpose rather than noticed later.
 *
 * A catalogue earns more of these than an ordinary site. The URLs are legible
 * — /bags/<brand>/<model>/ is an invitation to type one — and they move: a
 * model that merges into another overnight, or loses the specs that made it
 * indexable, leaves a real link that used to work. The reader in that case has
 * not made a mistake, so the page says what happened and hands them the
 * categories rather than apologising.
 *
 * noindex, because a search result should never land here. `follow`, though,
 * and that is the one deliberate deviation: the layout pairs noindex with
 * nofollow by default, which is right for /internal/ and wrong here, where
 * every link on the page goes somewhere worth crawling.
 */
const title = `Not found — ${SITE_NAME_DISPLAY}`;
const description =
  'That page is not here. The categories, the brand index and the carry-on '
  + 'tables are.';
---
<Base title={title} description={description} noindex nofollow={false}>
  <div class="page">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Bags</a> <span>/</span> <b>Not found</b>
    </nav>
    <h1>Not found</h1>
    {/* Two clauses. The rest of what stood here explained the rebuild cadence
        and the merge rules to somebody who has mistyped a URL, and closed on
        "Nothing was hidden — the address simply no longer names anything",
        which is the same sentence as the first one wearing a hat. */}
    <p class="note">
      There is no page at this address. Discontinued models lose their page
      when the index rebuilds.
    </p>

    <section>
      <h2>Browse by category</h2>
      <nav class="footrow" aria-label="Categories">
        {hubs.map((hub) => <a href={hub.href}>{hub.title}</a>)}
      </nav>
    </section>

    <section>
      <h2>Or start from</h2>
      <nav class="footrow" aria-label="Site">
        <a href="/">Every bag, filterable</a>
        <a href="/brands/">Brands</a>
        <a href="/carry-on/">Carry-on sizes</a>
      </nav>
      <p class="note">
        Looking for a brand that is not in the index? There is a
        <b>Request a brand</b> button in the footer of every page, and the
        requests are what order the crawl.
      </p>
    </section>
  </div>
</Base>
