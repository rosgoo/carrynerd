---
import Base from '../layouts/Base.astro';
import { bags, meta, bagHref, byLabel, brands } from '../lib/catalog.js';
import { catLabel } from '../lib/labels.js';
import { fmtPrice } from '../lib/format.js';
import { hubs } from '../lib/hubs.js';
import BrowseHead from '../components/BrowseHead.astro';
import BrowseShell from '../components/BrowseShell.astro';
import SaleStrip from '../components/SaleStrip.astro';
import { SITE_NAME_DISPLAY, TAGLINE } from '../lib/brand.js';

const title = `${SITE_NAME_DISPLAY} — ${TAGLINE}`;
const description =
  `Compare ${meta.bag_count ?? bags.length} bags across ${meta.brand_count ?? 0} ` +
  'brands on volume, weight, dimensions and price. Specs normalised from public ' +
  'product feeds, with every value showing where it came from.';

/* The no-JavaScript fallback, and the two things that were wrong with it.
 *
 * It used to be every bag in the catalogue — one row per model, 8,043 of them,
 * 1,121,864 bytes, which was 98.3% of this page. Everything else here fits in
 * 19 KB. The reasoning was that a crawler running no JavaScript should still
 * reach every model page from the front door.
 *
 * What that missed is who pays. This list is not hidden by any stylesheet and
 * the island's first paint is gated on `await fetch('/api/browse')`, so every
 * real visitor downloaded it, built ~40,000 DOM nodes out of it, *saw* an
 * alphabetical list starting at 3F UL Gear, and then watched it be replaced by
 * the grid a network round trip later. The fallback was for crawlers and the
 * cost was paid by people, in main-thread time and in a visible swap.
 *
 * So: <noscript>, which browsers with scripting enabled skip rather than parse
 * into the DOM, and a sample rather than the catalogue. The one-hop link to
 * every model goes away and nothing is orphaned by it — every one of the 8,043
 * is linked from its brand page, all 150 brands are linked from /brands/, and
 * /brands/ is in the footer of every page. Two hops instead of one, for a
 * client that is not a person.
 *
 * Grouped by category rather than capped alphabetically, because a flat list
 * truncated at N is a stub ending mid-alphabet for no stated reason, where
 * this is a sample of each shelf with the way to the rest of it attached.
 */
const FALLBACK_PER_HUB = 12;

const fallbackGroups = hubs.map((hub) => ({
  title: hub.title,
  href: hub.href,
  plural: hub.plural,
  total: hub.total,
  bags: [...hub.bags]
    .sort((a, b) => byLabel(a.brand, b.brand) || byLabel(a.name, b.name))
    .slice(0, FALLBACK_PER_HUB),
})).filter((group) => group.bags.length);

// A few brands sell from storefronts that quote something other than dollars,
// and nothing here converts them — a rate would be a number we invented, and
// it would move between crawls independently of any price. The consequence is
// that the price slider compares figures in different currencies, which is
// worth saying out loud rather than leaving a reader to notice a £ in the
// results. Computed rather than hardcoded so the line disappears by itself if
// the roster ever goes back to being USD-only.
const otherCurrencies = [
  ...new Set(bags.map((b) => b.currency).filter((c) => c && c !== 'USD')),
].sort();
---
{/* The chrome, the rail and the grid are components because the brand pages
    mount the same island — see components/BrowseShell.astro. This page is the
    unscoped case: no brand fixed, so the rail keeps its Brand group and the
    counts are the catalogue's. */}
<Base title={title} description={description}>
  <BrowseHead slot="header" />

  {/* Above the shell, so it spans the filter rail as well as the grid. It is
      not a filter and it is not a result — it is the one thing on the page
      that a returning reader could not have worked out for themselves, so it
      goes where the eye lands before either. Renders nothing on a night with
      no drops rather than sitting there empty. */}
  <SaleStrip bags={bags} />

  <BrowseShell otherCurrencies={otherCurrencies}>
    {/* Inside #results, which browse.js overwrites wholesale on load — so for
        anyone running scripts this is inert markup the parser skips and the
        island discards, and the grid is reached without it ever existing. */}
    <noscript>
      <div class="nojs">
        <p class="note">
          The filters and the comparison grid need JavaScript. Below is a
          sample of each category; every model in the index is listed on its
          brand's page.
        </p>
        {fallbackGroups.map((group) => (
          <section>
            <h2><a href={group.href}>{group.title}</a></h2>
            <ul class="nojs-index">
              {group.bags.map((bag) => (
                <li>
                  <a href={bagHref(bag)}>
                    <b>{bag.brand}</b> {bag.name}
                    <em>{catLabel(bag.category)}{bag.volume_l ? ` · ${bag.volume_l} L` : ''} · {fmtPrice(bag.price_min, bag.currency)}</em>
                  </a>
                </li>
              ))}
            </ul>
            <p class="note">
              <a href={group.href}>All {group.total} {group.plural} →</a>
            </p>
          </section>
        ))}
        <p class="note">
          Or browse <a href="/brands/">all {brands.length} brands</a>, where
          every one of the {meta.bag_count ?? bags.length} models is listed.
        </p>
      </div>
    </noscript>
  </BrowseShell>

  <script>
    import '../scripts/browse.js';
  </script>
</Base>
