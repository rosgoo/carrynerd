---
import '../styles/app.css';
import Logo from '../components/Logo.astro';
import { SITE_NAME_DISPLAY } from '../lib/brand.js';

const {
  title,
  description = 'A searchable, comparable index of bags normalised across brands from public product feeds.',
  image = null,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex,nofollow" />}

<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{image && <meta property="og:image" content={image} />}
<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />

<!-- Restore the saved theme before first paint. Deferring this to the island
     would flash dark-on-light for anyone who chose the light theme. -->
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<script is:inline>
  try {
    const saved = localStorage.getItem('bagdex-theme');
    if (saved) document.documentElement.setAttribute('data-theme', saved);
  } catch {}
</script>
<slot name="head" />
</head>
<body>

<slot name="header">
  <header>
    <a class="brand" href="/"><Logo size={17} />{SITE_NAME_DISPLAY}</a>
    <div class="stats"></div>
    <div class="spacer"></div>
    <nav class="hbtns">
      <a class="hbtn" href="/">Browse</a>
      <a class="hbtn" href="/brands/">Brands</a>
      <button class="hbtn" id="theme" title="Toggle theme">Theme</button>
    </nav>
  </header>
</slot>

<slot />

<footer class="sitefoot">
  <a href="/brands/">Brands</a>
  <a href="/privacy/">Privacy</a>
  <a href="/bot/">About the crawler</a>
  <span>
    Specs are extracted from brands' published product feeds, not hand-checked.
    Nothing is estimated — verify against the brand before buying.
  </span>
</footer>

<script>
  // The theme toggle is the one behaviour every page shares.
  document.getElementById('theme')?.addEventListener('click', () => {
    const next =
      document.documentElement.getAttribute('data-theme') === 'dark'
        ? 'light'
        : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    try {
      localStorage.setItem('bagdex-theme', next);
    } catch {}
  });
</script>
</body>
</html>
