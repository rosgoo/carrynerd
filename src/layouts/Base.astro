---
import '../styles/app.css';
import Logo from '../components/Logo.astro';
import Analytics from '../components/Analytics.astro';
import RequestBrand from '../components/RequestBrand.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import HeaderMenu from '../components/HeaderMenu.astro';
import { SITE_NAME_DISPLAY, SITE_DESCRIPTION, TAGLINE } from '../lib/brand.js';
import { siteGraph } from '../lib/schema.js';
import { hubs } from '../lib/hubs.js';
import { meta } from '../lib/catalog.js';

interface Props {
  title: string;
  description?: string;
  image?: string | null;
  ogType?: string;
  noindex?: boolean;
  nofollow?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  image = null,
  ogType = 'website',
  noindex = false,
  // Separate from noindex, because the two cases want different things.
  // /internal/ is a working list that should be neither indexed nor crawled
  // onward. A model page held back for thin content is an ordinary page that
  // merely should not be a search result yet — its links to the brand page and
  // the comparison views are still worth following, so it takes noindex,follow.
  nofollow = true,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const robots = noindex ? `noindex,${nofollow ? 'nofollow' : 'follow'}` : null;

/* Every page gets a card, which until now only the model pages did.
 *
 * `image` is the product photo on a model page and null on all ~200 others —
 * the homepage, the fourteen hubs and their facets, the brand index and every
 * brand page, the carry-on tables, /privacy, /bot. Those emitted no og:image
 * at all, so a link to any of them unfurled as a bare URL: no card, no mark,
 * nothing to distinguish it from a paste. public/og.png is the fallback, drawn
 * by scripts/og_image.py.
 *
 * Absolute on purpose. og:image is fetched by a machine that never loaded the
 * page and has no base to resolve against, and a relative path is the single
 * most common way this tag silently does nothing. A model page's `bag.image`
 * is already a CDN URL, so only the fallback needs building here.
 *
 * The width and height go out only with the fallback, where they are known to
 * be true. Stating them lets Slack and LinkedIn commit to a large card without
 * fetching the file first; stating them for a product photo of unknown
 * proportions would be a guess, and a wrong one crops the bag.
 */
const OG_FALLBACK = new URL('/og.png', Astro.site).href;
const ogImage = image || OG_FALLBACK;
const ogFallback = ogImage === OG_FALLBACK;
const ogImageAlt = ogFallback ? `${SITE_NAME_DISPLAY} — ${TAGLINE}` : title;

/* Who this site is, declared once. See lib/schema.js for what the two nodes
 * are for and why the pair of them is home-page-only.
 *
 * In the layout rather than on index.astro because the home page is a browse
 * shell whose frontmatter is about filters and counts, and this is about the
 * site — but gated on the path rather than shipped everywhere, which is the
 * other obvious way to do it. Repeating ~900 bytes of identical markup across
 * 4,200 pages buys nothing: `@id` already makes every declaration of this
 * entity the same entity, so the second copy is not a second signal, only
 * bytes on every page in the catalogue.
 */
const isHome = Astro.url.pathname === '/';

/* Why <html> below carries data-units but no data-theme.
 *
 * The absence is load-bearing. Every theme rule in app.css is built around "no
 * attribute" meaning "the reader has not asked", which is what hands the
 * question to prefers-color-scheme; writing a default here would take that back,
 * and doing exactly that is the bug this replaced — the attribute was pinned to
 * dark, so the media query's guard never passed and a reader whose system asked
 * for light was served dark anyway. The head script sets it only for someone
 * who has actually chosen.
 *
 * data-units stays pinned, because there is no system preference for
 * centimetres to defer to.
 *
 * Both of these belong here rather than in a comment above the tag: between the
 * doctype and <html>, an Astro expression is content, not a note, and the
 * document builder responds by dropping <html>, <head> and <body> from the
 * output. */
---
<!doctype html>
<html lang="en" data-units="cm">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{robots && <meta name="robots" content={robots} />}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE_NAME_DISPLAY} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={ogImageAlt} />
{ogFallback && <meta property="og:image:width" content="1200" />}
{ogFallback && <meta property="og:image:height" content="630" />}
<meta name="twitter:card" content="summary_large_image" />

{/* is:inline because this is data for a crawler, not code: it has to ship in
    the document as written rather than be bundled and fetched. Same reasoning
    as the JSON-LD on the model and hub pages. */}
{isHome && (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(siteGraph(Astro.site))} />
)}

<!-- Restore the saved theme and unit before first paint. Deferring either to
     the island would flash — the wrong palette for anyone who chose against
     their system, and centimetres for anyone who chose inches, since every
     length on the page ships in both units and CSS picks one.

     Only what was chosen is written. Leaving the attribute off is what hands
     the question to prefers-color-scheme, so a reader who has never touched
     the toggle gets their system's answer rather than ours; setting it to a
     default here would take that back and is the bug this replaced. -->
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<script is:inline>
  // These keys are deliberately not brand-named. The site has been renamed
  // twice, and a brand-named key means every rename silently resets the theme
  // and units for everyone who ever set them — the exact flash this script
  // exists to prevent, handed out once per rename. Neutral keys end that.
  //
  // The migration below carries the last brand-named values across and then
  // forgets them. Safe to delete once returning visitors have cycled through.
  try {
    for (const [old, key] of [['calipered-theme', 'theme'],
                              ['calipered-units', 'units']]) {
      const prev = localStorage.getItem(old);
      if (prev === null) continue;
      if (localStorage.getItem(key) === null) localStorage.setItem(key, prev);
      localStorage.removeItem(old);
    }
    const saved = localStorage.getItem('theme');
    if (saved) document.documentElement.setAttribute('data-theme', saved);
    const units = localStorage.getItem('units');
    if (units) document.documentElement.setAttribute('data-units', units);
  } catch {}
</script>
<slot name="head" />
</head>
<body>

<slot name="header">
  <header>
    <a class="brand" href="/"><Logo size={17} />{SITE_NAME_DISPLAY}</a>
    {/* The same three numbers the browse header carries, which this one shipped
        an empty bordered cell in place of — so a reader moving from the front
        page to a hub watched the catalogue's size vanish and the nav slide
        across. Static here rather than written by script, because these pages
        run no island and the figures are fixed for the life of the deploy. */}
    <div class="stats">
      <span><b>{(meta.bag_count ?? 0).toLocaleString('en-US')}</b> BAGS</span>
      <span><b>{(meta.brand_count ?? 0).toLocaleString('en-US')}</b> BRANDS</span>
      <span><b>{(meta.sku_count ?? 0).toLocaleString('en-US')}</b> SKUS</span>
    </div>
    <nav class="hbtns">
      {/* Carry-on takes Browse's place rather than joining it. Browse was a
          second link to "/" on a header whose wordmark already goes there, and
          /carry-on/ was reachable only from the footer — which, under an
          infinite scroll, is a place you cannot get to. Two of the site's four
          real sections were behind a scroll that does not end. A swap rather
          than an addition because this nav is already three rows on a small
          phone and a seventh item would make it four. */}
      <a class="hbtn" href="/carry-on/">Carry-on</a>
      {/* The hubs were reachable only from the footer, which is the right
          place for a link graph and the wrong one for a reader: someone on
          /daypacks/ had nothing above the fold telling them travel backpacks
          were also held. A <details> rather than a scripted menu because
          these pages mount no island — see the note on the script below. */}
      <HeaderMenu units />
      {/* Next to the categories rather than out with the reference pages: it
          is a shelf like they are, cut by price instead of by shape. */}
      <a class="hbtn" href="/sale/">Sale</a>
      <a class="hbtn" href="/brands/">Brands</a>
      {/* Stays in the nav here, and only here. On a browse page this control
          sits in the toolbar above the results, beside the sort, because that
          is what it acts on — see components/BrowseShell.astro. The pages that
          fall back to this header have no toolbar to put it in: their lengths
          are spread across a model's spec grid or several comparison tables at
          once, so the header is the only place that governs all of them. Those
          pages render the other header, never both, so the id stays unique.

          A pair now, not one button that cycles. It used to print the unit you
          were already in — "cm" while you were reading centimetres — which is
          the opposite grammar to the theme toggle sitting immediately right of
          it, where the moon is where you are going rather than where you are.
          Two adjacent controls disagreeing about whether they report or offer
          is a question a reader can only settle by pressing one and watching
          what happens; both units on screen with the live one lit settles it by
          never asking. That also makes it the same control as Grid/Table on the
          browse toolbar, which is where the shape is borrowed from.

          aria-pressed ships saying cm because <html> ships saying cm. The head
          script may have moved the attribute since, so the script at the foot
          of this file puts the two back in step on load — CSS has the paint
          covered before then. */}
      <div class="units" id="units" role="group" aria-label="Measurement units">
        <button class="hbtn" type="button" data-unit="cm" aria-pressed="true"
                title="Show measurements in centimetres and grams"
                aria-label="Show measurements in centimetres and grams">cm</button>
        <button class="hbtn" type="button" data-unit="in" aria-pressed="false"
                title="Show measurements in inches and pounds"
                aria-label="Show measurements in inches and pounds">in</button>
      </div>
      <ThemeToggle />
    </nav>
  </header>
</slot>

<slot />

<footer class="sitefoot">
  {/* Every category, on every page. Before the hubs existed the only route
      between two model pages was their shared brand, which left 4,000 leaves
      hanging off 149 twigs and nothing joining them across makers. This row is
      the cheapest possible fix and it belongs in the layout rather than on the
      pages, so no page can be built without it. */}
  <nav class="footrow" aria-label="Categories">
    {hubs.map((hub) => <a href={hub.href}>{hub.title}</a>)}
  </nav>
  <nav class="footrow" aria-label="Site">
    <a href="/sale/">On sale</a>
    <a href="/carry-on/">Carry-on sizes</a>
    <a href="/brands/">Brands</a>
    {/* In the layout because the answer to "you don't have my brand" has to be
        reachable from wherever a reader worked that out, and on a model page
        or a category hub the footer is the only site-wide furniture there is.
        Ships hidden; request-brand.js reveals it — see the note there. */}
    <button class="footbtn" type="button" data-request-brand hidden>Request a brand</button>
    {/* First in this row, and above the crawler link rather than beside it:
        one of these answers "what is this site and can I trust the numbers"
        and the other answers "why is something fetching my products.json".
        The second is for store operators and has been mislabelled as the
        site's about page for as long as it was the only thing called about. */}
    <a href="/about/">About</a>
    <a href="/privacy/">Privacy</a>
    <a href="/bot/">About the crawler</a>
  </nav>
</footer>

<RequestBrand />

<script>
  // Theme and units are the two behaviours every page shares. Both are one
  // attribute on <html> that CSS reads, so neither needs the page re-rendered
  // — which is what lets them work on the static model pages, where no island
  // is mounted at all.
  //
  // They are wired separately now, and only because the two controls are
  // shaped differently: the theme is one button that cycles, so it asks what
  // it is not; the units are a pair, so each half simply states the value it
  // selects and has nothing to work out. `swap` is what is left of the shared
  // half, and with units gone the theme is its only caller — hence no event
  // parameter any more, the theme being pure CSS with nobody to tell.
  // `current` stays optional to keep the resolver below out of the signature's
  // way for anything that does not need one.
  const swap = (
    id: string,
    attr: string,
    key: string,
    values: [string, string],
    current?: () => string,
  ) =>
    document.getElementById(id)?.addEventListener('click', () => {
      const root = document.documentElement;
      const now = root.getAttribute(attr) ?? current?.() ?? values[0];
      const next = now === values[0] ? values[1] : values[0];
      root.setAttribute(attr, next);
      try {
        localStorage.setItem(key, next);
      } catch {}
    });

  // Keys are brand-neutral on purpose — see the migration note in <head>.
  //
  // The resolver is what makes the first press work now that <html> ships with
  // no data-theme. Reading the attribute alone, an unset one is not 'dark', so
  // the toggle computed 'dark' as the next value — correct for a reader on the
  // light default, and a no-op for one whose system asked for dark and who was
  // already looking at dark. One press that visibly did nothing. The media
  // query is the only other thing that decides the answer, so asking it is what
  // closes the gap.
  swap('theme', 'data-theme', 'theme', ['dark', 'light'],
       () => (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'));

  /* --head, measured rather than declared.
   *
   * --head is what the rail, the toolbar and the sticky table head hang off,
   * and it was a constant per breakpoint: 52 at desk widths, 48 below 760. The
   * header stopped being one row at those widths a while ago — the nav stays in
   * it now instead of folding into the drawer — so at 760 it is two rows and
   * 98px against a token saying 48, and the toolbar sticks fifty pixels up
   * underneath it. Narrower still it is three rows and the gap is a hundred.
   *
   * The comment on the token has been wrong twice for the same reason: the
   * height depends on where a nav of six items happens to wrap, which depends
   * on the font, the locale and how many items there are that week, and no
   * constant is going to keep up with that. So it is measured.
   *
   * Script is affordable here and nowhere near it. Theme and units cannot wait
   * for a bundle because getting them wrong for one frame is a visible flash;
   * --head positions things that are sticky, which is a scroll-time concern, so
   * being right shortly after load is being right. */
  /* Categories starts closed on a narrow screen and open on a wide one.
   *
   * It ships open, because that is what it means at desk widths — up there the
   * panel is the categories dropdown, its own summary is hidden by CSS, and an
   * `open` attribute is the only way a <details> shows its contents. Below the
   * breakpoint the panel is the whole navigation instead, Categories is one
   * item in it beside Sale and Brands, and fourteen links unrolled ahead of
   * those six is the branching item behaving least like one.
   *
   * CSS cannot do this: `open` is an attribute, and there is no property that
   * unsets it. So it is three lines here, on the media query the stylesheet
   * already breaks at. With no script the panel stays as it ships — flat, the
   * way it was yesterday — which is why open is the direction to fail in. */
  const sub = document.querySelector<HTMLDetailsElement>('.msub');
  if (sub) {
    const narrow = matchMedia('(max-width: 760px)');
    const syncSub = () => { sub.open = !narrow.matches; };
    syncSub();
    narrow.addEventListener('change', syncSub);
  }

  const header = document.querySelector('header');
  if (header) {
    const setHead = () => {
      const h = Math.round(header.getBoundingClientRect().height);
      if (h) document.documentElement.style.setProperty('--head', h + 'px');
    };
    setHead();
    if ('ResizeObserver' in window) new ResizeObserver(setHead).observe(header);
    else addEventListener('resize', setHead);
  }

  /* The unit pair — see the note on its markup above for why it is a pair.
   *
   * Which half looks lit is CSS's answer, keyed off the same data-units the
   * head script has already restored, because at first paint nothing down here
   * has run yet and a control that reports the wrong state until the bundle
   * lands is exactly the flash the rest of this file exists to avoid. What this
   * adds is aria-pressed, which a screen reader needs and a stylesheet has no
   * way to give it. The two say the same thing, so nothing moves when it lands.
   *
   * The attribute, the localStorage key and the unitchange event are all
   * unchanged: every .u-cm/.u-in span on the site, the browse island's inputs
   * and the saved preference are built on those three and none of them care how
   * many buttons write them. */
  const unitBtns =
    document.querySelectorAll<HTMLButtonElement>('.units [data-unit]');
  const paintUnits = () => {
    const now = document.documentElement.getAttribute('data-units') ?? 'cm';
    unitBtns.forEach((b) =>
      b.setAttribute('aria-pressed', String(b.dataset.unit === now)));
  };
  unitBtns.forEach((b) =>
    b.addEventListener('click', () => {
      const root = document.documentElement;
      const next = b.dataset.unit;
      // Pressing the half you are already in is a no-op rather than a toggle:
      // that was the old button's grammar, and half the point of the pair is
      // that "cm" means centimetres rather than "not what you have now".
      if (!next || next === root.getAttribute('data-units')) return;
      root.setAttribute('data-units', next);
      try {
        localStorage.setItem('units', next);
      } catch {}
      paintUnits();
      // The browse island keeps two lengths in <input>s, which CSS cannot
      // rewrite. It listens for this and converts them.
      document.dispatchEvent(new CustomEvent('unitchange', { detail: next }));
    }));
  paintUnits();

  // The categories menu opens and closes on its own — it is a <details>, which
  // is the whole reason it can be the one navigation affordance on pages that
  // run no other script. What a <details> has no notion of is dismissal, so
  // that is all this adds: click anywhere else, or Escape, and it shuts.
  // Without it the menu stays open behind whatever you looked at next.
  const menu = document.querySelector<HTMLDetailsElement>('.hmenu');
  if (menu) {
    document.addEventListener('click', (e) => {
      if (!menu.contains(e.target as Node)) menu.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') menu.open = false;
    });
  }
</script>

<Analytics />
</body>
</html>
