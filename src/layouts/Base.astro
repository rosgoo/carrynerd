---
import '../styles/app.css';
import Logo from '../components/Logo.astro';
import Analytics from '../components/Analytics.astro';
import { SITE_NAME_DISPLAY } from '../lib/brand.js';
import { hubs } from '../lib/hubs.js';

interface Props {
  title: string;
  description?: string;
  image?: string | null;
  ogType?: string;
  noindex?: boolean;
  nofollow?: boolean;
}

const {
  title,
  description = 'A searchable, comparable index of bags normalised across brands from public product feeds.',
  image = null,
  ogType = 'website',
  noindex = false,
  // Separate from noindex, because the two cases want different things.
  // /internal/ is a working list that should be neither indexed nor crawled
  // onward. A model page held back for thin content is an ordinary page that
  // merely should not be a search result yet — its links to the brand page and
  // the comparison views are still worth following, so it takes noindex,follow.
  nofollow = true,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const robots = noindex ? `noindex,${nofollow ? 'nofollow' : 'follow'}` : null;
---
<!doctype html>
<html lang="en" data-theme="dark" data-units="cm">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{robots && <meta name="robots" content={robots} />}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE_NAME_DISPLAY} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{image && <meta property="og:image" content={image} />}
<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />

<!-- Restore the saved theme and unit before first paint. Deferring either to
     the island would flash — dark-on-light for anyone who chose the light
     theme, and centimetres for anyone who chose inches, since every length on
     the page ships in both units and CSS picks one. -->
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<script is:inline>
  // These keys are deliberately not brand-named. The site has been renamed
  // twice, and a brand-named key means every rename silently resets the theme
  // and units for everyone who ever set them — the exact flash this script
  // exists to prevent, handed out once per rename. Neutral keys end that.
  //
  // The migration below carries the last brand-named values across and then
  // forgets them. Safe to delete once returning visitors have cycled through.
  try {
    for (const [old, key] of [['calipered-theme', 'theme'],
                              ['calipered-units', 'units']]) {
      const prev = localStorage.getItem(old);
      if (prev === null) continue;
      if (localStorage.getItem(key) === null) localStorage.setItem(key, prev);
      localStorage.removeItem(old);
    }
    const saved = localStorage.getItem('theme');
    if (saved) document.documentElement.setAttribute('data-theme', saved);
    const units = localStorage.getItem('units');
    if (units) document.documentElement.setAttribute('data-units', units);
  } catch {}
</script>
<slot name="head" />
</head>
<body>

<slot name="header">
  <header>
    <a class="brand" href="/"><Logo size={17} />{SITE_NAME_DISPLAY}</a>
    <div class="stats"></div>
    <div class="spacer"></div>
    <nav class="hbtns">
      <a class="hbtn" href="/">Browse</a>
      {/* The hubs were reachable only from the footer, which is the right
          place for a link graph and the wrong one for a reader: someone on
          /daypacks/ had nothing above the fold telling them travel backpacks
          were also held. A <details> rather than a scripted menu because
          these pages mount no island — see the note on the script below. */}
      <details class="hmenu">
        <summary class="hbtn">Categories</summary>
        <div class="hmenupanel">
          {hubs.map((hub) => <a href={hub.href}>{hub.title}</a>)}
        </div>
      </details>
      <a class="hbtn" href="/carry-on/">Carry-on</a>
      <a class="hbtn" href="/brands/">Brands</a>
      <button class="hbtn units" id="units" title="Show lengths in centimetres or inches">
        <span class="u-cm">cm</span><span class="u-in">in</span>
      </button>
      <button class="hbtn" id="theme" title="Toggle theme">Theme</button>
    </nav>
  </header>
</slot>

<slot />

<footer class="sitefoot">
  {/* Every category, on every page. Before the hubs existed the only route
      between two model pages was their shared brand, which left 4,000 leaves
      hanging off 149 twigs and nothing joining them across makers. This row is
      the cheapest possible fix and it belongs in the layout rather than on the
      pages, so no page can be built without it. */}
  <nav class="footrow" aria-label="Categories">
    {hubs.map((hub) => <a href={hub.href}>{hub.title}</a>)}
  </nav>
  <nav class="footrow" aria-label="Site">
    <a href="/carry-on/">Carry-on sizes</a>
    <a href="/brands/">Brands</a>
    <a href="/privacy/">Privacy</a>
    <a href="/bot/">About the crawler</a>
  </nav>
</footer>

<script>
  // Theme and units are the two behaviours every page shares. Both are one
  // attribute on <html> that CSS reads, so neither needs the page re-rendered
  // — which is what lets them work on the static model pages, where no island
  // is mounted at all.
  // `event` is optional: the theme toggle is pure CSS and has nobody to tell.
  const swap = (
    id: string,
    attr: string,
    key: string,
    values: [string, string],
    event?: string,
  ) =>
    document.getElementById(id)?.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.getAttribute(attr) === values[0] ? values[1] : values[0];
      root.setAttribute(attr, next);
      try {
        localStorage.setItem(key, next);
      } catch {}
      if (event) document.dispatchEvent(new CustomEvent(event, { detail: next }));
    });

  // Keys are brand-neutral on purpose — see the migration note in <head>.
  swap('theme', 'data-theme', 'theme', ['dark', 'light']);
  // The browse island keeps two lengths in <input>s, which CSS cannot rewrite.
  // It listens for this and converts them.
  swap('units', 'data-units', 'units', ['cm', 'in'], 'unitchange');

  // The categories menu opens and closes on its own — it is a <details>, which
  // is the whole reason it can be the one navigation affordance on pages that
  // run no other script. What a <details> has no notion of is dismissal, so
  // that is all this adds: click anywhere else, or Escape, and it shuts.
  // Without it the menu stays open behind whatever you looked at next.
  const menu = document.querySelector<HTMLDetailsElement>('.hmenu');
  if (menu) {
    document.addEventListener('click', (e) => {
      if (!menu.contains(e.target as Node)) menu.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') menu.open = false;
    });
  }
</script>

<Analytics />
</body>
</html>
